&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = "run",
  centroid = "%s.cen",
  sigma = "%s.sig",
  semaphore_file = "%s.done",
  random_number_seed = 91827364,
  tracking_updates = 0,
  show_element_timing = 0,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 8,
&end

&bunched_beam
  n_particles_per_bunch = 32768,
  emit_x = 2e-12,
  beta_x = 9,
  emit_y = 2e-12,
  beta_y = 7,
  sigma_dp = 1e-5,
  sigma_s = 8e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
