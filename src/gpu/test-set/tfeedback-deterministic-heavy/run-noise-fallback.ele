&run_setup
  lattice = "lattice-noise.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 1,
  rootname = "run-noise-fallback",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
&end
&run_control n_passes=2 &end
&bunched_beam
  n_particles_per_bunch=256,
  emit_x=1e-9, beta_x=8, emit_y=8e-10, beta_y=6,
  sigma_dp=5e-5, sigma_s=8e-4,
  distribution_type[0]=3*"gaussian", distribution_cutoff[0]=3*3,
&end
&track &end
