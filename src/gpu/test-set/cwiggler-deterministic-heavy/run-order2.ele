&run_setup
  lattice = "lattice-order2.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  rootname = "run-order2",
  centroid = "%s.cen",
  sigma = "%s.sig",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 128,
  emit_x = 8e-9,
  beta_x = 5,
  emit_y = 6e-9,
  beta_y = 4,
  sigma_dp = 1e-4,
  sigma_s = 5e-4,
&end

&track
&end
