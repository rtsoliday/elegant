&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  rootname = "run-loss",
  final = "%s.fin",
  losses = "%s.lost",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 128,
  emit_x = 2e-5,
  beta_x = 8,
  emit_y = 2e-5,
  beta_y = 8,
  sigma_dp = 8e-5,
  sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
