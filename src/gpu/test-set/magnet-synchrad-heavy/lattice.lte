D: DRIF,L=0.05
QF: KQUAD,L=0.20,K1=1.20,N_SLICES=16,INTEGRATION_ORDER=4,SYNCH_RAD=1,ISR=0
QD: KQUAD,L=0.20,K1=-1.20,N_SLICES=16,INTEGRATION_ORDER=4,SYNCH_RAD=1,ISR=0
B1: CSBEND,L=0.40,ANGLE=0.032,E1=0.016,E2=0.016,HGAP=0.01,FINT=0.40,K1=0.08,K2=0.03,N_SLICES=16,INTEGRATION_ORDER=4,EDGE_ORDER=1,EDGE1_EFFECTS=1,EDGE2_EFFECTS=1,SYNCH_RAD=1,ISR=0
B2: CSBEND,L=0.40,ANGLE=-0.032,E1=-0.016,E2=-0.016,HGAP=0.01,FINT=0.40,K1=-0.08,K2=-0.03,N_SLICES=16,INTEGRATION_ORDER=4,EDGE_ORDER=1,EDGE1_EFFECTS=1,EDGE2_EFFECTS=1,SYNCH_RAD=1,ISR=0
KM1: GKICKMAP,L=0.40,INPUT_FILE="kickmap.sdds",N_KICKS=16,FACTOR=0.20,SYNCH_RAD=1,ISR=0
KM2: GKICKMAP,L=0.40,INPUT_FILE="kickmap.sdds",N_KICKS=16,FACTOR=-0.20,SYNCH_RAD=1,ISR=0
UK1: UKICKMAP,L=0.40,INPUT_FILE="ukickmap.sdds",N_KICKS=16,PERIODS=16,KREF=2.0,FIELD_FACTOR=1,SYNCH_RAD=1,ISR=0
UK2: UKICKMAP,L=0.40,INPUT_FILE="ukickmap-negative.sdds",N_KICKS=16,PERIODS=16,KREF=2.0,FIELD_FACTOR=1,SYNCH_RAD=1,ISR=0
W1: WATCH,FILENAME="%s.w1",MODE="centroid"
CELL: LINE=(D,QF,D,QD,D,B1,D,B2,D,KM1,D,KM2,D,UK1,D,UK2)
RING: LINE=(8*CELL,W1)
