&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  rootname = "run",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 0,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 3,
&end

&bunched_beam
  n_particles_per_bunch = 16384,
  emit_x = 1e-9,
  beta_x = 6,
  alpha_x = 0,
  emit_y = 8e-10,
  beta_y = 5,
  alpha_y = 0,
  sigma_dp = 8e-5,
  sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
