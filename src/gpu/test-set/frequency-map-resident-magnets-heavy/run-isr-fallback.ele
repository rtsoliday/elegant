! ISR is order-sensitive and must retain scalar CPU tune tracking.

&run_setup
    lattice = "lattice-isr.lte",
    use_beamline = "RING",
    p_central_mev = 6000,
    default_order = 2,
    random_number_seed = 987654321,
    semaphore_file = "%s.done"
&end

&run_control
    n_steps = 1,
    n_passes = 8
&end

&frequency_map
    output = "%s.fma",
    ndelta = 1,
    nx = 6,
    ny = 6,
    xmin = 1e-6,
    xmax = 0.0001,
    ymin = 1e-6,
    ymax = 0.0001,
    full_grid_output = 1,
    include_changes = 1,
    verbosity = 0
&end
