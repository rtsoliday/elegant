D: DRIF,L=0.20
QF: QUAD,L=0.20,K1=0.55,ORDER=1
QD: QUAD,L=0.20,K1=-0.55,ORDER=1

SRFULL: SREFFECTS,JX=1.2,JY=0.8,JDELTA=2,DDELTAREF=-2e-5,PREF=12000,FRACTION=0.25,DAMPING=1,QEXCITATION=0,LOSSES=1,INCLUDE_OFFSETS=1
SRNOFF: SREFFECTS,JX=1.2,JY=0.8,JDELTA=2,DDELTAREF=-2e-5,PREF=12000,FRACTION=0.25,DAMPING=1,QEXCITATION=0,LOSSES=1,INCLUDE_OFFSETS=0
SRDAMP: SREFFECTS,JX=1.2,JY=0.8,JDELTA=2,DDELTAREF=-2e-5,PREF=12000,FRACTION=0.25,DAMPING=1,QEXCITATION=0,LOSSES=0,INCLUDE_OFFSETS=1
SRLOSS: SREFFECTS,JX=1.2,JY=0.8,JDELTA=2,DDELTAREF=-2e-5,PREF=12000,FRACTION=0.25,DAMPING=0,QEXCITATION=0,LOSSES=1,INCLUDE_OFFSETS=1

SRE: LINE=(SRFULL,SRNOFF,SRDAMP,SRLOSS)
W1: WATCH,FILENAME="%s.w1",MODE="centroid"
RING: LINE=(D,QF,D,QD,64*SRE,W1)
