&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central = 12000,
  default_order = 1,
  rootname = "run",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 0,
  load_balancing_on = 0,
&end

&twiss_output
  filename = "%s.twi",
  matched = 0,
  output_at_each_step = 0,
  beta_x = 8,
  alpha_x = 0,
  eta_x = 0.10,
  etap_x = 0.01,
  beta_y = 6,
  alpha_y = 0,
  eta_y = 0.05,
  etap_y = -0.005,
&end

&run_control
  n_passes = 4,
&end

&bunched_beam
  n_particles_per_bunch = 65536,
  emit_x = 2e-9,
  beta_x = 8,
  alpha_x = 0,
  emit_y = 1e-9,
  beta_y = 6,
  alpha_y = 0,
  sigma_dp = 1e-4,
  sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
