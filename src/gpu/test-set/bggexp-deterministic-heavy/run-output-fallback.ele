&run_setup
  lattice = "lattice-output.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  rootname = "run-output-fallback",
  final = "%s.fin",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 1,
  emit_x = 0,
  beta_x = 1,
  emit_y = 0,
  beta_y = 1,
  sigma_dp = 0,
  sigma_s = 0,
&end

&track
&end
