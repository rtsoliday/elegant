&run_setup
  lattice = "lattice-output.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 1,
  rootname = "run-output-fallback",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
&end
&run_control n_passes = 2 &end
&bunched_beam
  n_particles_per_bunch = 16384,
  sigma_dp = 5e-5,
  sigma_s = 8e-4,
&end
&track &end
