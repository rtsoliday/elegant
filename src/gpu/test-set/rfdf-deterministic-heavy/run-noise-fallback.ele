&run_setup
  lattice = "lattice-noise.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  rootname = "run-noise-fallback",
  final = "%s.fin",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
&end

&run_control
  n_passes = 2,
&end

&bunched_beam
  n_particles_per_bunch = 1024,
  emit_x = 1e-9,
  beta_x = 8,
  emit_y = 1e-9,
  beta_y = 7,
  sigma_dp = 8e-5,
  sigma_s = 4e-4,
&end

&track
&end
