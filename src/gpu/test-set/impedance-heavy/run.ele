&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = "run",
  centroid = "%s.cen",
  sigma = "%s.sig",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 0,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 60,
&end

&bunched_beam
  n_particles_per_bunch = 200000,
  emit_x = 1.0e-9,
  beta_x = 8,
  alpha_x = 0,
  emit_y = 8.0e-10,
  beta_y = 6,
  alpha_y = 0,
  sigma_dp = 6e-5,
  sigma_s = 5e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
  centroid[0] = 4.0e-4,
  centroid[2] = -3.0e-4,
&end

&track
&end
