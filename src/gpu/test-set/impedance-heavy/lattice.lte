Q: CHARGE, TOTAL=1e-9
Z: IMPEDANCE, INPUTFILE="impedance.sdds", FREQCOLUMN="f", &
  ZL_REAL="ReZL", ZL_IMAG="ImZL", &
  ZXD_REAL="ReZxD", ZXD_IMAG="ImZxD", &
  ZYD_REAL="ReZyD", ZYD_IMAG="ImZyD", &
  ZXQ_REAL="ReZxQ", ZXQ_IMAG="ImZxQ", &
  ZYQ_REAL="ReZyQ", ZYQ_IMAG="ImZyQ", &
  INTERPOLATE=1, SMOOTHING=0, BUNCHED_BEAM_MODE=1
RING: LINE=(Q,Z)
