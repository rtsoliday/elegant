&insert_sceffects
  name = *,
  type = DRIF,
  skip = 1,
  horizontal = 1,
  vertical = 1,
  nonlinear = 1,
  uniform_distribution = 0,
  slice_duration = 0,
  averaging_factor = 1,
&end

&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = "run",
  centroid = "%s.cen",
  sigma = "%s.sig",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 0,
  load_balancing_on = 0,
&end

&twiss_output
  matched = 1,
  filename = "%s.twi",
  output_at_each_step = 0,
&end

&run_control
  n_passes = 20,
&end

&bunched_beam
  n_particles_per_bunch = 50000,
  emit_x = 2.0e-9,
  beta_x = 12,
  alpha_x = 0.2,
  emit_y = 5.0e-10,
  beta_y = 5,
  alpha_y = -0.1,
  sigma_dp = 8e-5,
  sigma_s = 7e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
