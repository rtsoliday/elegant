&run_setup
  lattice = "multipole-loss.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  rootname = "multipole-loss",
  output = "%s.out",
  acceptance = "%s.acc",
  semaphore_file = "%s.done",
  random_number_seed = 314159265,
  tracking_updates = 0,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 8192,
  emit_x = 1e-7,
  beta_x = 5,
  emit_y = 8e-8,
  beta_y = 4,
  sigma_dp = 8e-5,
  sigma_s = 8e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
