&run_setup
  lattice = "csbend.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  rootname = "csbend-body",
  output = "%s.out",
  acceptance = "%s.acc",
  semaphore_file = "%s.done",
  random_number_seed = 192837465,
  tracking_updates = 0,
&end
&alter_elements name=BP, item=EDGE1_EFFECTS, value=0 &end
&alter_elements name=BP, item=EDGE2_EFFECTS, value=0 &end
&alter_elements name=BP, item=N_SLICES, value=1 &end
&alter_elements name=BN, item=EDGE1_EFFECTS, value=0 &end
&alter_elements name=BN, item=EDGE2_EFFECTS, value=0 &end
&alter_elements name=BN, item=N_SLICES, value=1 &end
&run_control n_passes=1 &end
&bunched_beam
  n_particles_per_bunch = 8192,
  emit_x = 1e-10, beta_x = 8, alpha_x = 0.1,
  emit_y = 8e-11, beta_y = 6, alpha_y = -0.1,
  sigma_dp = 8e-5, sigma_s = 8e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end
&track &end
