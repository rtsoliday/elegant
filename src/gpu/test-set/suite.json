{
  "name": "elegant GPU-heavy performance suite",
  "suite_type": "gpu-performance",
  "minimum_speedup": 2.0,
  "gpu_noise_absolute_tolerance": 1e-15,
  "gpu_noise_relative_tolerance": 1e-9,
  "recommended_jobs": 1,
  "require_gpu_activity": true,
  "gpu_environment": {
    "ELEGANT_GPU_MODE": "required",
    "ELEGANT_GPU_VERBOSE": "1",
    "ELEGANT_GPU_MIN_PARTICLES": "1",
    "ELEGANT_GPU_MIN_MATRIX_DRIFT_PARTICLES": "1",
    "ELEGANT_GPU_MIN_HELPER_PARTICLES": "1",
    "ELEGANT_GPU_MIN_OUTPUT_DRIFT_REDUCTION_PARTICLES": "1",
    "ELEGANT_GPU_MIN_MAGNET_PARTICLES": "32",
    "ELEGANT_GPU_MIN_WAKE_PARTICLES": "1",
    "ELEGANT_GPU_MIN_LSC_PARTICLES": "1",
    "ELEGANT_GPU_MIN_CSR_PARTICLES": "1",
    "ELEGANT_GPU_MIN_SCMULT_PARTICLES": "1",
    "ELEGANT_GPU_MIN_BATCHED_TUNE_PARTICLES": "32",
    "ELEGANT_GPU_MIN_BATCHED_SEARCH_PARTICLES": "32",
    "ELEGANT_GPU_ENABLE_RFCA_CHANGE_P0_DRIFT": "1",
    "ELEGANT_GPU_MIN_RFDF_PARTICLES": "64",
    "ELEGANT_GPU_MIN_BGGEXP_PARTICLES": "64",
    "ELEGANT_GPU_MIN_CWIGGLER_PARTICLES": "64",
    "ELEGANT_GPU_MIN_FTABLE_PARTICLES": "64",
    "ELEGANT_GPU_MIN_BMXYZ_PARTICLES": "64",
    "ELEGANT_GPU_MIN_LORENTZ_PARTICLES": "64",
    "ELEGANT_GPU_MIN_CCBEND_PARTICLES": "64",
    "ELEGANT_GPU_MIN_LGBEND_PARTICLES": "64",
    "ELEGANT_GPU_MIN_RFMODE_PARTICLES": "8192",
    "ELEGANT_GPU_MIN_SREFFECTS_PARTICLES": "64",
    "ELEGANT_GPU_MIN_HISTOGRAM_PARTICLES": "64",
    "ELEGANT_GPU_MIN_TFEEDBACK_PARTICLES": "64",
    "ELEGANT_GPU_BATCHED_TUNE_THREADS": "16"
  },
  "description": "Fixed-workload CPU/GPU parity and runtime benchmarks"
}
