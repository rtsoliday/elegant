Q: CHARGE, TOTAL=1e-9
W: CWAKE, INPUTFILE="wake.sdds", TCOLUMN="t", &
  WZCOLUMN="wlflat", WXCOLUMN="wdip", WYCOLUMN="wdip", &
  QXCOLUMN="wquad", QYCOLUMN="wquad", &
  CXCOLUMN="wquad", CYCOLUMN="wquad", CXFACTOR=-1e-3, CYFACTOR=-1e-3, &
  N_BINS=5000, INTERPOLATE=1, SMOOTHING=0, BUNCHED_BEAM_MODE=1
RING: LINE=(Q,W)
