&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = "run-small-fallback",
  semaphore_file = "%s.done",
  random_number_seed = 314159265,
  tracking_updates = 0,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 32,
  emit_x = 1.5e-9,
  beta_x = 9,
  emit_y = 8e-10,
  beta_y = 6,
  sigma_dp = 8e-5,
  sigma_s = 6e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
