D: DRIF,L=0.02
H: HISTOGRAM,FILENAME="%s.hist",BINS=2048,FIXED_BIN_SIZE=0,X_DATA=1,Y_DATA=1,LONGIT_DATA=1,NORMALIZE=1,SPARSE=0
HPID: HISTOGRAM,FILENAME="%s.pid.hist",BINS=1024,FIXED_BIN_SIZE=1,X_DATA=1,Y_DATA=0,LONGIT_DATA=0,NORMALIZE=0,SPARSE=0,START_PID=1001,END_PID=250000
W: WATCH,FILENAME="%s.par",MODE="parameters",INTERVAL=1
CELL: LINE=(D,H)
RING: LINE=(24*CELL,HPID,W)
