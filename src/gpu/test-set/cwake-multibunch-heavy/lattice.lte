Q: CHARGE, TOTAL=5e-9
WALL: CWAKE, INPUTFILE="../cwake-heavy/wake.sdds", TCOLUMN="t", &
  WZCOLUMN="Wz", WXCOLUMN="Wx", WYCOLUMN="Wy", &
  QXCOLUMN="Qx", QYCOLUMN="Qy", CXCOLUMN="Cx", CYCOLUMN="Cy", &
  N_BINS=256, INTERPOLATE=1, SMOOTHING=0, BUNCHED_BEAM_MODE=1
WPART: CWAKE, INPUTFILE="../cwake-heavy/wake.sdds", TCOLUMN="t", &
  WZCOLUMN="Wz", WXCOLUMN="Wx", WYCOLUMN="Wy", &
  QXCOLUMN="Qx", QYCOLUMN="Qy", CXCOLUMN="Cx", CYCOLUMN="Cy", &
  N_BINS=256, INTERPOLATE=1, SMOOTHING=0, BUNCHED_BEAM_MODE=1, &
  START_BUNCH=1, END_BUNCH=3
RING: LINE=(Q,WALL,WPART)
