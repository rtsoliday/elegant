&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  rootname = "run-small-fallback",
  final = "%s.fin",
  random_number_seed = 271828183,
  tracking_updates = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 32,
  emit_x = 8e-9,
  beta_x = 5,
  emit_y = 6e-9,
  beta_y = 4,
  sigma_dp = 1e-4,
  sigma_s = 5e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
