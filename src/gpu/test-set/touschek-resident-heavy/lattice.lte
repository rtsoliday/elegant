Q: CHARGE,TOTAL=1e-9
D: DRIF,L=0.20
DM: DRIF,L=1e-12
QF: KQUAD,L=0.20,K1=0.90,N_SLICES=4,INTEGRATION_ORDER=4,SYNCH_RAD=0,ISR=0
QD: KQUAD,L=0.20,K1=-0.90,N_SLICES=4,INTEGRATION_ORDER=4,SYNCH_RAD=0,ISR=0
SRE: SREFFECTS,JX=1.1,JY=0.9,JDELTA=2,DDELTAREF=-1e-7,PREF=11741.7,FRACTION=0.01,DAMPING=1,QEXCITATION=0,LOSSES=1,INCLUDE_OFFSETS=0
TS0: TSCATTER
TS: TSCATTER
RFM: RFMODE,RA=1,Q=5000,FREQ=1.05e9,BETA=0.5,N_BINS=128,BIN_SIZE=5e-12,INTERPOLATE=1,N_CAVITIES=1,BUNCHED_BEAM_MODE=1
AP: RCOL,X_MAX=0.01,Y_MAX=0.01

SAMPLE: LINE=(DM,TS)
CELL: LINE=(D,QF,D,QD,SRE,16*SAMPLE)
RING: LINE=(TS0,Q,15*CELL,D,QF,D,QD,SRE,RFM,AP,16*SAMPLE)
