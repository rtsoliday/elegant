! CSBEND edge models 2 (K. Hwang), 3 (symplectic Brown kick) and 4 (Hwang as symplectified by R.
! Lindberg), at edge orders 1 and 2, with gaps, FINT, pole-face curvature, mixed models, kick limits,
! a gradient, TILT, the expanded Hamiltonian and a negative angle.  KQUADs keep the beam on the device.
D: DRIF,L=0.2
Q: KQUAD,L=0.2,K1=0.8,N_SLICES=4
B1: CSBEND,L=0.5,ANGLE=0.1,E1=0.05,E2=0.04,HGAP=0.01,FINT=0.5,EDGE1_EFFECTS=2,EDGE2_EFFECTS=2,EDGE_ORDER=1,N_SLICES=8,INTEGRATION_ORDER=4
B2: CSBEND,L=0.5,ANGLE=0.1,E1=0.05,E2=0.04,HGAP=0.01,FINT=0.5,H1=0.3,H2=-0.2,EDGE1_EFFECTS=2,EDGE2_EFFECTS=2,EDGE_ORDER=2,N_SLICES=8,INTEGRATION_ORDER=4,K1=0.3
B3: CSBEND,L=0.5,ANGLE=0.1,E1=0.03,E2=0.06,HGAP=0.012,FINT=0.4,EDGE1_EFFECTS=3,EDGE2_EFFECTS=3,EDGE1_KICK_LIMIT=2e-6,N_SLICES=8,INTEGRATION_ORDER=4,TILT=0.2
B4: CSBEND,L=0.5,ANGLE=0.1,E1=0.05,E2=0.05,HGAP=0.01,FINT1=0.6,FINT2=0.3,H1=0.2,H2=0.1,EDGE1_EFFECTS=4,EDGE2_EFFECTS=4,N_SLICES=8,INTEGRATION_ORDER=6,DX=2e-4
B5: CSBEND,L=0.5,ANGLE=-0.1,E1=0.02,E2=0.03,HGAP=0.01,FINT=0.5,EDGE1_EFFECTS=2,EDGE2_EFFECTS=4,EDGE_ORDER=2,N_SLICES=8,INTEGRATION_ORDER=4
B6: CSBEND,L=0.5,ANGLE=0.1,E1=0.04,E2=0.02,HGAP=0.01,FINT=0.5,EDGE1_EFFECTS=3,EDGE2_EFFECTS=2,N_SLICES=8,INTEGRATION_ORDER=2,EXPAND_HAMILTONIAN=1
B7: CSBEND,L=0.5,ANGLE=0.1,E1=0.05,E2=0.05,HGAP=0.01,FINT=0.5,EDGE1_EFFECTS=4,EDGE2_EFFECTS=3,N_SLICES=8,INTEGRATION_ORDER=4,EXPAND_HAMILTONIAN=1
RING: LINE=(B1,D,Q,D,B2,D,Q,D,B3,D,Q,D,B4,D,Q,D,B5,D,Q,D,B6,D,Q,D,B7,D,Q,D)
