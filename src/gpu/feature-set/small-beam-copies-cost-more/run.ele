! 2,000 particles through runs of six matrix elements between PFILTERs. The six would save about
! 0.12 ms on the device and the two copies of the beam cost 0.08 ms, under the 1.4 the estimate asks
! for, so the thresholds stay and the output is the CPU's bit for bit.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "BL",
  p_central_mev = 1000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 1 &end
&bunched_beam
  n_particles_per_bunch = 2000,
  emit_x = 1e-8, emit_y = 1e-8,
  beta_x = 5, beta_y = 5,
  sigma_dp = 1e-4, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end
&track &end
