! 12,000 particles for 2 passes, the default thresholds.  A lone first-order matrix is estimated at
! 15 ns a particle on the CPU, 0.18 ms, and its trip to the device at 0.29 ms, so it stays, on both
! passes: the output is the CPU's bit for bit.  A build that sends every short run to the device
! changes W's sums.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "BL",
  p_central_mev = 1000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 2 &end
&bunched_beam
  n_particles_per_bunch = 12000,
  emit_x = 1e-8, emit_y = 1e-8,
  beta_x = 5, beta_y = 5,
  sigma_dp = 1e-4, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end
&track &end
