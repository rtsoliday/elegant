! LGBEND ISR a segment at a time, with a beam that passes the first segment and spreads into the aperture in later ones, so a loss must restore the beam from before the magnet for the CPU to redo it.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 7000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 2 &end

&bunched_beam
  n_particles_per_bunch = 1000,
  emit_x = 2e-6, beta_x = 0.5, alpha_x = 0,
  emit_y = 2e-6, beta_y = 0.5, alpha_y = 0,
  sigma_dp = 5e-4, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*2.5,
&end

&track &end
