! 12,000 particles, the default thresholds.  Three matrix elements are estimated at 45 ns a particle on
! the CPU, 0.54 ms, against 30 us on the device and two copies of the beam, 0.31 ms: more than the 1.4
! times asked for, so every run goes to the device and W's sums are the device's.  A build that goes by
! the count alone never uses the device here.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "BL",
  p_central_mev = 1000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 1 &end
&bunched_beam
  n_particles_per_bunch = 12000,
  emit_x = 1e-8, emit_y = 1e-8,
  beta_x = 5, beta_y = 5,
  sigma_dp = 1e-4, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end
&track &end
