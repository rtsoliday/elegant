! slice-device-passes's SLICE elements with ELEGANT_GPU_ENABLE_SLICE=0 (suite.json): the read-only host copy
! and the host's single pass over the beam, as before. Identical
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 7 &end
&bunched_beam
  n_particles_per_bunch = 8000,
  emit_x = 5e-11, beta_x = 7, alpha_x = 0.3,
  emit_y = 5e-12, beta_y = 2.5, alpha_y = -0.2,
  sigma_dp = 0.001, sigma_s = 0.004,
&end
&track &end
