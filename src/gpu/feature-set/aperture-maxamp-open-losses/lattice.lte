D: DRIF,L=0.5
Q: QUAD,L=0.2,K1=2
AP: MAXAMP,X_MAX=3e-3,Y_MAX=3e-3,OPEN_SIDE="+x"
AM: MAXAMP,X_MAX=3e-3,Y_MAX=3e-3,OPEN_SIDE="-x"
AY: MAXAMP,X_MAX=3e-3,Y_MAX=3e-3,OPEN_SIDE="+y"
AN: MAXAMP,X_MAX=3e-3,Y_MAX=3e-3,OPEN_SIDE="-y"
EP: MAXAMP,X_MAX=3e-3,Y_MAX=3e-3,ELLIPTICAL=1,OPEN_SIDE="+x"
EM: MAXAMP,X_MAX=3e-3,Y_MAX=3e-3,ELLIPTICAL=1,OPEN_SIDE="-y"
RING: LINE=(AP,D,Q,D,EP,D,Q,D,AY,D,Q,D,EM,D,Q,D)
