! 12,000 particles, cut to under 10,000 by a collimator on the first pass, then sent to the host by a
! PFILTER each pass. The estimate says the kick magnets pay down to about 440 particles, so the
! thresholds come down for this call and the beam returns to the device after each PFILTER.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 1000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 6 &end
&bunched_beam
  n_particles_per_bunch = 12000,
  emit_x = 1e-8, emit_y = 1e-8,
  beta_x = 5, beta_y = 5,
  sigma_dp = 1e-4, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end
&track &end
