! LGBEND behind a sticky APCONTOUR with Logic expressions, keeping particles inside either of two rectangles and outside either of two holes, with the contour and the magnet offset and tilted.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = "run",
  centroid = "%s.cen",
  sigma = "%s.sig",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 2 &end

&bunched_beam
  n_particles_per_bunch = 2000,
  emit_x = 5e-7, beta_x = 4, alpha_x = 0,
  emit_y = 5e-7, beta_y = 4, alpha_y = 0,
  sigma_dp = 5e-4, sigma_s = 1e-3,
&end

&track &end
