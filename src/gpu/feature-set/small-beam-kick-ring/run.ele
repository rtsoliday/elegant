! 2,000 particles, under the 10,000 general thresholds, in a ring of kick magnets for 10 passes. The
! estimate puts the CPU at 18 ms a pass and the device at 2.6 ms, so the thresholds come down for
! this call and the beam goes on the device. Auto mode with the default thresholds.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 1000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 10 &end
&bunched_beam
  n_particles_per_bunch = 2000,
  emit_x = 1e-8, emit_y = 1e-8,
  beta_x = 5, beta_y = 5,
  sigma_dp = 1e-4, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end
&track &end
