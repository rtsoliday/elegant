! The three field expansions on a planar and a helical undulator: "ideal", "exact" with TGU_GRADIENT and
! TGU_COMP_FACTOR, "leading terms"; non-default POLE_FACTORs on one. An off-axis beam so the cosh, sinh
! and gradient terms matter. Rounding expected.
Q1: QUAD, L=0.1, K1=0.5
D: DRIF, L=0.2
LP1: LSRMDLTR, L=0.3, PERIODS=8, BU=0.4, N_STEPS=500, ACCURACY=1e-6, FIELD_EXPANSION="ideal", &
    LASER_PEAK_POWER=2e6, LASER_W0=4e-4
LP2: LSRMDLTR, L=0.3, PERIODS=8, BU=0.4, N_STEPS=500, ACCURACY=1e-6, FIELD_EXPANSION="exact", &
    TGU_GRADIENT=20, TGU_COMP_FACTOR=0.8, LASER_PEAK_POWER=2e6, LASER_W0=4e-4
LP3: LSRMDLTR, L=0.3, PERIODS=8, BU=0.4, N_STEPS=500, ACCURACY=1e-6, FIELD_EXPANSION="leading terms", &
    POLE_FACTOR1=0.2, POLE_FACTOR2=0.45, POLE_FACTOR3=0.85
LH1: LSRMDLTR, L=0.3, PERIODS=8, BU=0.3, N_STEPS=500, ACCURACY=1e-6, HELICAL=1, FIELD_EXPANSION="ideal", &
    LASER_PEAK_POWER=2e6, LASER_W0=4e-4
LH2: LSRMDLTR, L=0.3, PERIODS=8, BU=0.3, N_STEPS=500, ACCURACY=1e-6, HELICAL=1, FIELD_EXPANSION="exact"
LH3: LSRMDLTR, L=0.3, PERIODS=8, BU=0.3, N_STEPS=500, ACCURACY=1e-6, HELICAL=1, FIELD_EXPANSION="leading"
K: KICKER, HKICK=2e-5, VKICK=-1e-5
BL: LINE=(Q1, D, K, LP1, D, LP2, D, LP3, D, LH1, D, LH2, D, LH3, D)
