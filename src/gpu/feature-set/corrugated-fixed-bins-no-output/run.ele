&run_setup
  lattice = "lattice.lte",
  use_beamline = "BL",
  p_central_mev = 4000,
  default_order = 2,
  rootname = run,
  centroid = "%s.cen",
  sigma = "%s.sig",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 3,
&end

&bunched_beam
  n_particles_per_bunch = 5000,
  emit_nx = 1e-6, emit_ny = 1e-6, beta_x = 10, beta_y = 10,
  sigma_dp = 1e-4, sigma_s = 1e-5,
  distribution_type[0] = 3*"gaussian", distribution_cutoff[0] = 3*3,
&end

&track
&end
