! ELEGANT_GPU_ENABLE_CORRUGATED=0 (from suite.json) keeps CORGPIPE and CORGPLATES on the CPU. The particles
! must be elegant's.
C: CHARGE, TOTAL=1e-9
D: DRIF, L=0.5
CP: CORGPIPE, L=1.33, RADIUS=3e-3, DEPTH=450e-6, PERIOD=1e-3, GAP=750e-6, TMAX=0, INTERPOLATE=1
CPL: CORGPLATES, L=1.0, HALFGAP=2e-3, PERIOD=0.5e-3, DEPTH=0.5e-3, TMAX=0
BL: LINE=(C, D, CP, D, CPL, D)
