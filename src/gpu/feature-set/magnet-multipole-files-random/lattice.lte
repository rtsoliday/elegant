D: DRIF,L=0.2
QF: KQUAD,L=0.2,K1=1.2,N_SLICES=4,INTEGRATION_ORDER=4,SYSTEMATIC_MULTIPOLES="../data/mult_quad_systematic.sdds",RANDOM_MULTIPOLES="../data/mult_quad_random.sdds"
QD: KQUAD,L=0.2,K1=-1.2,N_SLICES=4,INTEGRATION_ORDER=4,RANDOM_MULTIPOLES="../data/mult_quad_random.sdds",RANDOM_MULTIPOLE_FACTOR=2
SF: KSEXT,L=0.1,K2=20,N_SLICES=4,INTEGRATION_ORDER=4,SYSTEMATIC_MULTIPOLES="../data/mult_sext_systematic.sdds",RANDOM_MULTIPOLES="../data/mult_sext_random.sdds"
O: KOCT,L=0.1,K3=300,N_SLICES=4,INTEGRATION_ORDER=4,RANDOM_MULTIPOLES="../data/mult_oct_random.sdds"
CELL: LINE=(D,QF,D,SF,D,QD,D,O)
RING: LINE=(4*CELL)
