MA: MAXAMP,X_MAX=6e-4,Y_MAX=6e-4,ELLIPTICAL=1
MB: MAXAMP,X_MAX=1e-9,Y_MAX=1e-9
D: DRIF,L=0.2
QF: KQUAD,L=0.2,K1=1.2,N_SLICES=6,INTEGRATION_ORDER=4,TILT=0.02,DX=1e-4,EDGE1_EFFECTS=1,EDGE2_EFFECTS=1
QD: KQUAD,L=0.2,K1=-1.2,N_SLICES=6,INTEGRATION_ORDER=6
SF: KSEXT,L=0.1,K2=20,N_SLICES=4,DY=-1e-4
OC: KOCT,L=0.1,K3=500,N_SLICES=4,TILT=0.3
QS: KQUSE,L=0.2,K1=0.8,K2=10,N_SLICES=4
CELL: LINE=(D,QF,D,SF,D,QD,D,OC,D,QS)
! the second aperture is set after the first cell, so the first magnet after it loses every particle left
RING: LINE=(MA,CELL,MB,CELL)
