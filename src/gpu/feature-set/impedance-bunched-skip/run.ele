&run_setup
  lattice = "lattice.lte",
  use_beamline = "MAKE",
  p_central_mev = 6000,
  default_order = 2,
  rootname = run_seed,
  output = "%s.out",
  final = "%s.fin",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 0,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 1000,
  bunch = "%s.bun",
  emit_x = 1e-9,
  beta_x = 8,
  alpha_x = 0,
  emit_y = 1e-9,
  beta_y = 8,
  alpha_y = 0,
  sigma_dp = 5e-5,
  sigma_s = 3e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end

&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = run,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 5,
&end

&sdds_beam
  input = run_seed.out,
  use_bunched_mode = 1,
  n_duplicates = 2,
  duplicate_stagger[4] = 1e-9,
  fiducialization_bunch = -1,
&end

&track
&end
