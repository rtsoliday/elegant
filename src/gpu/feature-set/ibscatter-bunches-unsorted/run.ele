! IBSCATTER on three bunches after an RCOL removes particles of each, so the rows reach it out of bunch order: the device gathers them by bunch (each bunch keeps elegant's order), copies each bunch down for the sums, inflates, and writes the rows back. Only an output file, so the particles must be elegant's.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "MAKE",
  p_central = 11742,
  default_order = 2,
  rootname = run_seed,
  output = "%s.out",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 0,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 3000,
  bunch = "%s.bun",
  emit_x = 1e-10, emit_y = 1e-11, beta_x = 12.0035, alpha_x = -1.07284, beta_y = 11.1046, alpha_y = 1.00549, eta_x = 2.58301,
  sigma_dp = 1e-3, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian", distribution_cutoff[0] = 3*3,
&end

&track
&end

&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central = 11742,
  default_order = 2,
  rootname = run,
  output = "%s.out",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 5,
&end

&twiss_output matched = 1, radiation_integrals = 1 &end

&sdds_beam
  input = run_seed.out,
  use_bunched_mode = 1,
  n_duplicates = 2,
  duplicate_stagger[4] = 1e-9,
  fiducialization_bunch = -1,
&end

&track
&end
