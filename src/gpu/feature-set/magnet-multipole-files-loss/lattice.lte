MA: MAXAMP,X_MAX=1.2e-3,Y_MAX=1.2e-3,ELLIPTICAL=0
D: DRIF,L=0.2
QF: KQUAD,L=0.2,K1=1.2,N_SLICES=4,INTEGRATION_ORDER=4,SYSTEMATIC_MULTIPOLES="../data/mult_quad_systematic.sdds",RANDOM_MULTIPOLES="../data/mult_quad_random.sdds"
QD: KQUAD,L=0.2,K1=-1.2,N_SLICES=4,INTEGRATION_ORDER=4,EDGE_MULTIPOLES="../data/mult_edge.sdds"
SF: KSEXT,L=0.1,K2=20,N_SLICES=4,INTEGRATION_ORDER=4,SYSTEMATIC_MULTIPOLES="../data/mult_sext_systematic.sdds"
CELL: LINE=(D,QF,D,SF,D,QD)
RING: LINE=(MA,4*CELL)
