&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = run,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 2,
&end

&bunched_beam
  n_particles_per_bunch = 3000,
  bunch = "%s.bun",
  emit_x = 2e-11,
  beta_x = 12,
  alpha_x = 0,
  emit_y = 2e-11,
  beta_y = 10,
  alpha_y = 0,
  sigma_dp = 4e-5,
  sigma_s = 4e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
