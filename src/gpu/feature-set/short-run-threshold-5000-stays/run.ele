! 5,000 particles with the suite's thresholds of 64, so only the short-run rule decides.  The run is
! estimated at 45 ns a particle on the CPU, 225 us, and at 30 us on the device plus two copies of 20 us
! and 10 ns a particle, 170 us.  225 is under 1.4 times 170, so the runs stay and the output is the
! CPU's bit for bit.  The rule changes sides at 5,765 particles: see short-run-threshold-6500-goes.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "BL",
  p_central_mev = 1000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 1 &end
&bunched_beam
  n_particles_per_bunch = 5000,
  emit_x = 1e-8, emit_y = 1e-8,
  beta_x = 5, beta_y = 5,
  sigma_dp = 1e-4, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end
&track &end
