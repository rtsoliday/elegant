! Device-resident n-line aperture search with a sticky APCONTOUR first in the ring: the multipoles check
! it inside and every element after it checks it at its end (imposeApContour()), with the CPU's s for a
! loss.  The drift after SF is two halves.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = "run",
  semaphore_file = "%s.done",
  tracking_updates = 0,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 128,
&end

&find_aperture
  mode = "n-line",
  n_lines = 7,
  xmax = 0.024,
  ymax = 0.012,
  nx = 65,
  n_splits = 3,
  split_fraction = 0.2,
  desired_resolution = 1e-5,
  output = "%s.aper",
  verbosity = 0,
&end
