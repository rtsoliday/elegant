Q: CHARGE, TOTAL=1e-9
ZS: ZTRANSVERSE, INPUTFILE="../data/impedance.sdds", FREQCOLUMN="f", &
  ZXREAL="ReZxD", ZXIMAG="ImZxD", ZYREAL="ReZyD", ZYIMAG="ImZyD", &
  SMOOTHING=1, SG_ORDER=1, SG_HALFWIDTH=3, FACTOR=1e-3, YFACTOR=0, START_ON_PASS=1, INTERPOLATE=1, &
  WAKES="%s.twk", WAKE_INTERVAL=2, BUNCHED_BEAM_MODE=1
ZB: ZTRANSVERSE, BROAD_BAND=1, RS=1e6, Q=1, FREQ=2e10, BIN_SIZE=1e-12, N_BINS=256, &
  INTERPOLATE=1, WAKES="%s.twb", BUNCHED_BEAM_MODE=1
D0: DRIF, L=37.5
D1: DRIF, L=0.2
RING: LINE=(Q,D0,ZS,D1,ZB)
