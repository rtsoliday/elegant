D: DRIF,L=0.5
Q: QUAD,L=0.2,K1=2
AP: MAXAMP,X_MAX=3e-3,Y_MAX=3e-3,ELLIPTICAL=1,OPEN_SIDE="+x"
AM: MAXAMP,X_MAX=3e-3,Y_MAX=3e-3,ELLIPTICAL=1,EXPONENT=4,OPEN_SIDE="-x"
AY: MAXAMP,X_MAX=3e-3,Y_MAX=3e-3,ELLIPTICAL=1,OPEN_SIDE="+y"
AN: MAXAMP,X_MAX=3e-3,Y_MAX=3e-3,ELLIPTICAL=1,OPEN_SIDE="-y"
RING: LINE=(AP,D,Q,D,AM,D,Q,D,AY,D,Q,D,AN,D,Q,D)
