! POLYNOMIALSERIES in required mode with fewer particles than the threshold, which falls back to the CPU inside the GPU path.
&run_setup
 lattice = "lattice.lte",
 use_beamline = "RING",
 p_central_mev = 450,
 default_order = 1,
 rootname = run,
 centroid = "%s.cen",
 sigma = "%s.sig",
 final = "%s.fin",
 output = "%s.out",
 semaphore_file = "%s.done",
 random_number_seed = 987654321,
 tracking_updates = 0,
&end

&run_control
 n_passes = 4,
&end

&bunched_beam
 n_particles_per_bunch = 32,
 bunch = "%s.bun",
 emit_x = 1e-9,
 beta_x = 5,
 alpha_x = 0,
 emit_y = 1e-9,
 beta_y = 5,
 alpha_y = 0,
 sigma_dp = 1e-4,
 sigma_s = 1e-3,
 distribution_type[0] = 3*"gaussian",
 distribution_cutoff[0] = 3*3,
&end

&track
&end
