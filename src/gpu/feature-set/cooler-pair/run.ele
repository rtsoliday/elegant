&run_setup
  lattice = "lattice.lte",
  use_beamline = "BL",
  p_central_mev = 6000,
  default_order = 2,
  rootname = run,
  output = "%s.out",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_steps = 1,
  n_passes = 4,
&end

&bunched_beam
  n_particles_per_bunch = 500,
  emit_x = 1e-08, emit_y = 1e-08, beta_x = 5, beta_y = 5, alpha_x = 0.5,
  sigma_dp = 0.001, sigma_s = 1e-05, dp_s_coupling = 0.3,
  distribution_type[0] = 3*"gaussian", distribution_cutoff[0] = 3*3,
&end

&track
&end
