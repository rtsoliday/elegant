! IBSCATTER on the device in a ring (ISRING=1, NSLICE=1, SMOOTH=1): the host copies the rows down and runs elegant's slicebeam() and computeSliceParameters(), the growth rates and the IBS output file; the device inflates the emittances. FACTOR=3e4 makes the inflation visible in 5 passes. Only an output file, so the particles must be elegant's.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central = 11742,
  default_order = 2,
  rootname = run,
  output = "%s.out",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 5,
&end

&twiss_output matched = 1, radiation_integrals = 1 &end

&bunched_beam
  n_particles_per_bunch = 4000,
  emit_x = 1e-10, emit_y = 1e-11, beta_x = 5, beta_y = 5,
  sigma_dp = 1e-3, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian", distribution_cutoff[0] = 3*3,
&end

&track
&end
