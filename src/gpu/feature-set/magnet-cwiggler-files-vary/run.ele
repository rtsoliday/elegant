! Changing length and field between steps changes the wavenumbers, so a stale harmonic table would show.
! No final output, because it finds each wiggler's matrix by tracking 11249 particles on the CPU.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 3000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 2, n_indices = 1 &end
&vary_element name = WH, item = L, initial = 0.2, final = 0.25, index_number = 0, index_limit = 3 &end
&vary_element name = WV, item = B_MAX, initial = 0.5, final = 0.7, index_number = 0 &end

&bunched_beam
  n_particles_per_bunch = 200,
  emit_x = 2e-7, beta_x = 8, alpha_x = 0,
  emit_y = 2e-7, beta_y = 8, alpha_y = 0,
  sigma_dp = 5e-4, sigma_s = 1e-3,
&end

&track &end
