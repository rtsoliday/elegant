D: DRIF,L=0.2
QF: KQUAD,L=0.2,K1=1.2,N_SLICES=4,INTEGRATION_ORDER=4,SYSTEMATIC_MULTIPOLES="../data/mult_quad_systematic.sdds",EDGE_MULTIPOLES="../data/mult_edge.sdds",STEERING_MULTIPOLES="../data/mult_steering.sdds",HKICK=1e-5,VKICK=-2e-5
QD: KQUAD,L=0.2,K1=-1.2,N_SLICES=4,INTEGRATION_ORDER=6,EDGE_MULTIPOLES="../data/mult_edge.sdds"
QS: KQUAD,L=0.2,K1=0.3,N_SLICES=4,INTEGRATION_ORDER=2,STEERING_MULTIPOLES="../data/mult_steering.sdds",HKICK=2e-5,STEERING_MULTIPOLE_FACTOR=0.5
SF: KSEXT,L=0.1,K2=20,N_SLICES=4,INTEGRATION_ORDER=4,EDGE_MULTIPOLES="../data/mult_edge.sdds",STEERING_MULTIPOLES="../data/mult_steering.sdds",VKICK=1e-5
CELL: LINE=(D,QF,D,SF,D,QD,D,QS)
RING: LINE=(4*CELL)
