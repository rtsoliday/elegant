&run_setup
  lattice = "lattice.lte",
  use_beamline = "NOISE_RING",
  p_central = 880,
  default_order = 2,
  rootname = "run",
  centroid = "%s.cen",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end

&twiss_output matched = 1 &end

&modulate_elements
  name = "HC?", item = KICK,
  distribution = gaussian, amplitude = 1e-7,
  correlated = 1, refresh_matrix = 1,
  record = "%s.gaussian",
&end
&modulate_elements
  name = VC1, item = KICK,
  distribution = plus_or_minus, amplitude = 5e-8,
  correlated = 0, refresh_matrix = 1,
  start_pass = 1, end_pass = 3,
  record = "%s.pm",
&end

&run_control n_steps = 1, n_passes = 5 &end

&bunched_beam
  n_particles_per_bunch = 1024,
  emit_x = 1e-9, beta_x = 8, alpha_x = 0,
  emit_y = 1e-9, beta_y = 8, alpha_y = 0,
  sigma_dp = 1e-5, sigma_s = 1e-3,
  centroid[0] = 1e-4,
&end

&track &end
