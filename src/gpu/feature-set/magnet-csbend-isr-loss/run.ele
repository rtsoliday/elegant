! CSBEND ISR where the aperture stops part of the beam, so the bend is redone on the CPU with the same random numbers. A CPU element with ISR follows.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 7000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 2 &end

&bunched_beam
  n_particles_per_bunch = 1000,
  emit_x = 2e-6, beta_x = 4, alpha_x = 0,
  emit_y = 2e-6, beta_y = 4, alpha_y = 0,
  sigma_dp = 5e-4, sigma_s = 1e-3,
&end

&track &end
