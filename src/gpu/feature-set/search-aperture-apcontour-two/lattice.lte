D: DRIF,L=0.20
QF: KQUAD,L=0.20,K1=1.2,N_SLICES=8,INTEGRATION_ORDER=4
QD: KQUAD,L=0.20,K1=-1.2,N_SLICES=8,INTEGRATION_ORDER=4
SF: KSEXT,L=0.10,K2=30,N_SLICES=8,INTEGRATION_ORDER=4
SD: KSEXT,L=0.10,K2=-30,N_SLICES=8,INTEGRATION_ORDER=4
OCT: KOCT,L=0.08,K3=0,N_SLICES=8,INTEGRATION_ORDER=4
AP: RCOL,X_MAX=0.016,Y_MAX=0.010
A1: APCONTOUR,FILENAME="contour1.sdds",XCOLUMN="x",YCOLUMN="y",STICKY=1
A2: APCONTOUR,FILENAME="contour2.sdds",XCOLUMN="x",YCOLUMN="y",STICKY=1,TILT=0.2,DX=5e-4
A3: APCONTOUR,FILENAME="contour2.sdds",XCOLUMN="x",YCOLUMN="y",XFACTOR=1.1,YFACTOR=0.9
AX: APCONTOUR,FILENAME="contour1.sdds",XCOLUMN="x",YCOLUMN="y",CANCEL=1
DH: DRIF,L=0.10
CELL: LINE=(AP,DH,DH,QF,D,SF,D,QD,D,SD,D,OCT)
RING: LINE=(A1,3*CELL,A2,2*CELL,AX,3*CELL)
