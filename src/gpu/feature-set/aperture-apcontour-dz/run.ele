! A sticky APCONTOUR with DZ, DX and TILT.  The beam diverges and is cut at twice its size, so x alone
! never leaves the contour but x + DZ*xp sometimes does: a check that ignored DZ would find no loss.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 7000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 2 &end

&bunched_beam
  n_particles_per_bunch = 2000,
  emit_x = 5e-7, beta_x = 0.5, alpha_x = -1,
  emit_y = 5e-7, beta_y = 4, alpha_y = 0,
  sigma_dp = 5e-4, sigma_s = 1e-3,
  distribution_cutoff[0] = 2, 2, 2,
&end

&track &end
