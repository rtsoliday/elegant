Q: CHARGE, TOTAL=1e-9
ZB: ZTRANSVERSE, BROAD_BAND=1, RS=1e6, Q=1, FREQ=2e10, BIN_SIZE=1e-12, N_BINS=256, &
  INTERPOLATE=1, DX=1e-5, DY=-2e-5, XFACTOR=0.7, RAMP_PASSES=3, BUNCHED_BEAM_MODE=1
ZQ: ZTRANSVERSE, INPUTFILE="../data/impedance.sdds", FREQCOLUMN="f", &
  ZXREAL="ReZxQ", ZXIMAG="ImZxQ", ZYREAL="ReZyQ", ZYIMAG="ImZyQ", &
  X_DRIVE_EXPONENT=0, Y_DRIVE_EXPONENT=0, X_PROBE_EXPONENT=1, Y_PROBE_EXPONENT=1, &
  INTERPOLATE=0, FACTOR=1e-4, BUNCHED_BEAM_MODE=1
ZD: ZTRANSVERSE, INPUTFILE="../data/impedance.sdds", FREQCOLUMN="f", &
  ZXREAL="ReZxD", ZXIMAG="ImZxD", ZYREAL="ReZyD", ZYIMAG="ImZyD", &
  X_PROBE_EXPONENT=2, Y_PROBE_EXPONENT=3, INTERPOLATE=1, FACTOR=1e-3, BUNCHED_BEAM_MODE=1
D0: DRIF, L=37.5
D1: DRIF, L=0.2
RING: LINE=(Q,D0,ZB,D1,ZQ,D1,ZD)
