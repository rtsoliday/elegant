! ZTRANSVERSE on the device with output in the CPU's order: a broad-band resonator driven by (x - DX) and (y - DY), interpolated, with XFACTOR and RAMP_PASSES; a file quadrupole impedance (drive exponents 0, probe exponents 1, not interpolated); and a file dipole impedance with probe exponents 2 and 3, where the device's power is ipow's to the last bit. The beam is off axis. Only an output file, so the particles must be elegant's.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = run,
  output = "%s.out",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 5,
&end

&bunched_beam
  n_particles_per_bunch = 20000,
  bunch = "%s.bun",
  emit_x = 1e-9,
  beta_x = 8,
  alpha_x = 0,
  emit_y = 1e-9,
  beta_y = 8,
  alpha_y = 0,
  sigma_dp = 5e-5,
  sigma_s = 3e-4,
  centroid[0] = 2e-4, -1e-5, -1e-4, 2e-5,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
