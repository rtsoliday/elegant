&run_setup
  lattice = lattice.lte,
  use_beamline = BL,
  p_central_mev = 1000,
  final = %s.fin,
  output = %s.out,
  random_number_seed = 1234567,
&end
&run_control n_steps = 1 &end
&bunched_beam
  n_particles_per_bunch = 20000,
  emit_nx = 1e-6, beta_x = 10, emit_ny = 1e-6, beta_y = 10,
  sigma_dp = 1e-3, sigma_s = 1e-3,
&end
&track &end
