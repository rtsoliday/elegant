! ZLONGIT with WAKES files, written by the host from the device's histograms: a file impedance with Savitzky-Golay smoothing on its own grid, interpolated, writing every second pass from pass 1, and a broad-band resonator with BIN_CENTERED=1 writing every pass (Ra, fo and Deltaf parameters). The WAKES tables and the particles must both be elegant's.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = run,
  output = "%s.out",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 5,
&end

&bunched_beam
  n_particles_per_bunch = 20000,
  bunch = "%s.bun",
  emit_x = 1e-9,
  beta_x = 8,
  alpha_x = 0,
  emit_y = 1e-9,
  beta_y = 8,
  alpha_y = 0,
  sigma_dp = 5e-5,
  sigma_s = 3e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
