D: DRIF,L=0.2
QF: KQUAD,L=0.2,K1=1.2,N_SLICES=4,INTEGRATION_ORDER=4,SYSTEMATIC_MULTIPOLES="../data/mult_quad_systematic.sdds"
QD: KQUAD,L=0.2,K1=-1.2,N_SLICES=4,INTEGRATION_ORDER=6,SYSTEMATIC_MULTIPOLES="../data/mult_quad_systematic.sdds"
SF: KSEXT,L=0.1,K2=20,K1=0.1,J1=0.05,N_SLICES=4,INTEGRATION_ORDER=4,SYSTEMATIC_MULTIPOLES="../data/mult_sext_systematic.sdds"
SD: KSEXT,L=0.1,K2=-20,N_SLICES=2,INTEGRATION_ORDER=2,SYSTEMATIC_MULTIPOLES="../data/mult_sext_systematic.sdds",SYSTEMATIC_MULTIPOLE_FACTOR=0.5
O: KOCT,L=0.1,K3=300,N_SLICES=4,INTEGRATION_ORDER=4,SYSTEMATIC_MULTIPOLES="../data/mult_oct_systematic.sdds"
CELL: LINE=(D,QF,D,SF,D,QD,D,SD,D,O)
RING: LINE=(4*CELL)
