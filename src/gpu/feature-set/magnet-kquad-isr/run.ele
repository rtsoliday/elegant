! KQUAD, KSEXT, KOCT and DQCOR ISR, with and without SYNCH_RAD, integration orders 2, 4 and 6, misalignments and TILT. A CPU element with ISR follows, so the random numbers must stay in step.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 7000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 2 &end

&bunched_beam
  n_particles_per_bunch = 500,
  emit_x = 2e-7, beta_x = 8, alpha_x = 0,
  emit_y = 2e-7, beta_y = 8, alpha_y = 0,
  sigma_dp = 5e-4, sigma_s = 1e-3,
&end

&track &end
