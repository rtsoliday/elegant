&run_setup
  lattice = "lattice.lte",
  use_beamline = "BL",
  p_central_mev = 150,
  default_order = 2,
  rootname = run,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&slice_analysis
  output = "%s.san",
  n_slices = 20,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 2000,
  bunch = "%s.bun",
  emit_nx = 1e-6,
  beta_x = 10,
  alpha_x = 0,
  emit_ny = 1e-6,
  beta_y = 10,
  alpha_y = 0,
  sigma_dp = 1e-3,
  sigma_s = 3e-4,
  dp_s_coupling = -0.5,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
