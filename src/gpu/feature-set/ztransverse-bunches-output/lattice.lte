CHG: CHARGE,TOTAL=1.0e-9
D1: DRIF,L=0.20
Z1: ZTRANSVERSE, INPUTFILE="../data/impedance.sdds", FREQCOLUMN="f", &
  ZXREAL="ReZxD", ZXIMAG="ImZxD", ZYREAL="ReZyD", ZYIMAG="ImZyD", &
  INTERPOLATE=1, BUNCHED_BEAM_MODE=1, START_BUNCH=0, END_BUNCH=1, WAKES="%s.twk"
MAKE: LINE=(D1)
CELL: LINE=(D1,Z1,D1)
RING: LINE=(CHG,4*CELL)
