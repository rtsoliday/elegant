! KQUAD ISR where the first step's large kick stops every particle at the magnet's entrance, so the CPU redo draws no random numbers and the second step must start from the same place in the sequence.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 7000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_indices = 1, n_passes = 1 &end
&vary_element name = HK, item = KICK, initial = 1.2, final = 0, index_number = 0, index_limit = 2 &end

&bunched_beam
  n_particles_per_bunch = 256,
  emit_x = 5e-9, beta_x = 4, alpha_x = 0,
  emit_y = 5e-9, beta_y = 4, alpha_y = 0,
  sigma_dp = 5e-4, sigma_s = 1e-3,
&end

&track &end
