D: DRIF,L=0.2
QF: KQUAD,L=0.2,K1=1.5,N_SLICES=4,INTEGRATION_ORDER=4
QD: KQUAD,L=0.2,K1=-1.5,N_SLICES=4,INTEGRATION_ORDER=4
WH: CWIGGLER,L=0.2,PERIODS=2,STEPS_PER_PERIOD=12,INTEGRATION_ORDER=4,B_MAX=0.5,BY_FILE="../data/cwig_by_phase.sdds",TILT=0.1
WV: CWIGGLER,L=0.2,PERIODS=2,STEPS_PER_PERIOD=12,INTEGRATION_ORDER=4,B_MAX=0.5,BX_FILE="../data/cwig_bx_split.sdds",BX_SPLIT_POLE=1
