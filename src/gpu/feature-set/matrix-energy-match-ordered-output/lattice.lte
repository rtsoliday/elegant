D1: DRIF,L=0.25
QF: QUAD,L=0.2,K1=1.1,ORDER=2
QD: QUAD,L=0.2,K1=-1.0,ORDER=2
MAL: MALIGN,DP=2e-5
MALE: MALIGN,DE=-3e-6
ENP: ENERGY,MATCH_PARTICLES=1
ENB: ENERGY,MATCH_BEAMLINE=1
ENS: ENERGY,CENTRAL_MOMENTUM=11742
W1: WATCH,FILENAME="%s.w1",MODE=COORDINATE
CELL: LINE=(D1,QF,MAL,ENP,D1,QD,MALE,ENB,ENS)
RING: LINE=(20*CELL,W1)
