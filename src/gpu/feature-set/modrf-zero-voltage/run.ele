&run_setup
  lattice = "lattice.lte",
  use_beamline = "par",
  p_central = 880,
  default_order = 1,
  concat_order = 1,
  rootname = run,
  output = "%s.out",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 8,
&end

&bunched_beam
  n_particles_per_bunch = 200,
  sigma_s = 0.275809061360000,
  sigma_dp = 0.41e-3,
  distribution_cutoff[0] = 3*4,
&end

&track
&end
