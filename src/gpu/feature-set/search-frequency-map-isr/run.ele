! Batched frequency map with ISR, which batched programs refuse because random numbers must be used in the CPU's order.

&run_setup
    lattice = "lattice.lte",
    use_beamline = "RING",
    p_central_mev = 6000,
    default_order = 2,
    random_number_seed = 987654321,
    semaphore_file = "%s.done"
&end

&run_control
    n_steps = 1,
    n_passes = 16
&end

&frequency_map
    output = "%s.fma",
    ndelta = 1,
    delta_min = 0,
    delta_max = 0,
    nx = 9,
    ny = 8,
    xmin = -1e-3,
    xmax = 1e-3,
    ymin = 1e-6,
    ymax = 1e-3,
    full_grid_output = 1,
    include_changes = 1,
    verbosity = 0
&end
