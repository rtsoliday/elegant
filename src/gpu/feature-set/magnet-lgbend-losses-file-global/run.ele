! LGBEND losses with a losses file and global loss coordinates: elegant's particles, passes and row order, values to rounding after the first bend.
&run_setup
  losses = "%s.los",
  losses_include_global_coordinates = 1,
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = run,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  acceptance = "%s.acc",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 3,
&end

&bunched_beam
  n_particles_per_bunch = 3000,
  bunch = "%s.bun",
  emit_x = 5e-2,
  beta_x = 1,
  alpha_x = 0,
  emit_y = 1.2e-1,
  beta_y = 1,
  alpha_y = 0,
  sigma_dp = 1e-4,
  sigma_s = 3e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
