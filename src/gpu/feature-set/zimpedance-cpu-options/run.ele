! The ZLONGIT and ZTRANSVERSE options that stay on the CPU: AREA_WEIGHT, REVERSE_TIME_ORDER, a drive exponent of 2 (an ipow histogram) and a probe exponent of 4 (the device's power is not ipow's there). The drifts run on the device; the particles must be elegant's.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = run,
  output = "%s.out",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 5,
&end

&bunched_beam
  n_particles_per_bunch = 20000,
  bunch = "%s.bun",
  emit_x = 1e-9,
  beta_x = 8,
  alpha_x = 0,
  emit_y = 1e-9,
  beta_y = 8,
  alpha_y = 0,
  sigma_dp = 5e-5,
  sigma_s = 3e-4,
  centroid[0] = 2e-4, -1e-5, -1e-4, 2e-5,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
