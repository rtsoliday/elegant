Q: CHARGE, TOTAL=1e-9
ZA: ZLONGIT, ZREAL="../data/impedance.sdds=f+ReZL", ZIMAG="../data/impedance.sdds=f+ImZL", &
  AREA_WEIGHT=1, INTERPOLATE=1, BUNCHED_BEAM_MODE=1
ZR: ZLONGIT, ZREAL="../data/impedance.sdds=f+ReZL", ZIMAG="../data/impedance.sdds=f+ImZL", &
  REVERSE_TIME_ORDER=1, BUNCHED_BEAM_MODE=1
ZT: ZTRANSVERSE, INPUTFILE="../data/impedance.sdds", FREQCOLUMN="f", &
  ZXREAL="ReZxD", ZXIMAG="ImZxD", ZYREAL="ReZyD", ZYIMAG="ImZyD", &
  X_DRIVE_EXPONENT=2, INTERPOLATE=1, FACTOR=1e-3, BUNCHED_BEAM_MODE=1
ZP: ZTRANSVERSE, INPUTFILE="../data/impedance.sdds", FREQCOLUMN="f", &
  ZXREAL="ReZxD", ZXIMAG="ImZxD", ZYREAL="ReZyD", ZYIMAG="ImZyD", &
  Y_PROBE_EXPONENT=4, INTERPOLATE=1, FACTOR=1e-3, BUNCHED_BEAM_MODE=1
D0: DRIF, L=37.5
D1: DRIF, L=0.2
RING: LINE=(Q,D0,ZA,D1,ZR,D1,ZT,D1,ZP)
