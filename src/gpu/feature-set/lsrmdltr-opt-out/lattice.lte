! ELEGANT_GPU_ENABLE_LSRMDLTR=0 (from suite.json) keeps LSRMDLTR on the CPU; the lattice is
! lsrmdltr-laser-heater's. The particles must be elegant's.
Q1: QUAD, L=0.1, K1=0.5
D: DRIF, L=0.2
LM: LSRMDLTR, L=0.4, PERIODS=10, BU=0.33, N_STEPS=600, ACCURACY=1e-6, LASER_PEAK_POWER=5e6, LASER_W0=3e-4, &
    LASER_PHASE=0.3, LASER_X0=2e-5, LASER_Y0=-1e-5, LASER_Z0=0.05
BL: LINE=(Q1, D, LM, D)
