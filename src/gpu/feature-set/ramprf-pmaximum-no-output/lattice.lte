! RAMPRF with a pmaximum fiducial, thin and long.
D: DRIF,L=0.5
QF: KQUAD,L=0.3,K1=1.0,N_SLICES=4
QD: KQUAD,L=0.3,K1=-1.0,N_SLICES=4
R1: RAMPRF,L=0.2,VOLT=2e6,PHASE=170,FREQ="c_mks 3.2 / 3 *",VOLT_WAVEFORM="rf.sdds=t+Voltage",FIDUCIAL="pmaximum"
R2: RAMPRF,L=0,VOLT=3e5,PHASE=178,FREQ="c_mks 3.2 / 6 *",FIDUCIAL="pmaximum",VOLT_WAVEFORM="rf.sdds=t+Voltage"
RING: LINE=(QF,D,R1,QD,D,R2,D)
