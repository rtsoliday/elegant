! RAMPRF pmaximum fiducials on the device with no particle output, so the kicks use the device's sin.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 1000,
  default_order = 2,
  rootname = "run",
  centroid = "%s.cen",
  sigma = "%s.sig",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 60 &end
&bunched_beam
  n_particles_per_bunch = 2000,
  emit_x = 1e-8, beta_x = 5, alpha_x = 0,
  emit_y = 1e-8, beta_y = 5, alpha_y = 0,
  sigma_dp = 1e-4, sigma_s = 1e-3,
  centroid[0] = 1e-4, centroid[4] = 2e-4,
&end
&track &end
