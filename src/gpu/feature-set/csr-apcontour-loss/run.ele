! CSRCSBEND inside a sticky APCONTOUR, losing particles in the body on the device in the CPU's order.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 100,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 1 &end
&bunched_beam
  n_particles_per_bunch = 3000,
  emit_x = 2e-6, beta_x = 0.2, alpha_x = 0,
  emit_y = 1e-6, beta_y = 0.5, alpha_y = 0,
  sigma_dp = 1e-3, sigma_s = 3e-4,
&end
&track &end
