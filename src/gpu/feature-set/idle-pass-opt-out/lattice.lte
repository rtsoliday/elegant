! ELEGANT_GPU_ENABLE_IDLE_PASS=0 (from suite.json): the idle elements of idle-pass-elements take the beam to the
! CPU on every pass, as before 2026-11-14.
D: DRIF, L=0.5
K: KICKER, HKICK=2e-4, VKICK=-1e-4
Q1: QUAD, L=0.2, K1=0.5
Q2: QUAD, L=0.2, K1=-0.5
TW: TWISS, BETAX=5, BETAY=5, APPLY_ONCE=1
RI: RIMULT
SC: SCATTER, XP=1e-5, YP=1e-5, STARTONPASS=2, ENDONPASS=3
M2: MARK
BR: BRANCH, COUNTER=3, BRANCH_TO="M2"
BL: LINE=(K, D, Q1, TW, D, RI, SC, BR, Q2, D, M2, D)
