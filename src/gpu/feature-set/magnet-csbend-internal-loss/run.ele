! CSBEND losses inside the bend, with output and a losses file, so the lost particles and where
! they were lost must match the CPU.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 1000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  losses = "%s.lost",
  centroid = "%s.cen",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 1 &end
&bunched_beam
  n_particles_per_bunch = 4000,
  emit_x = 6.3e-7, beta_x = 0.0637, alpha_x = 0,
  emit_y = 1e-12, beta_y = 1, alpha_y = 0,
  sigma_dp = 1e-4, sigma_s = 1e-3,
  distribution_cutoff[0] = 3*3,
&end
&track &end
