MA: MAXAMP,X_MAX=1.2e-3,Y_MAX=1.2e-3,ELLIPTICAL=0
D: DRIF,L=0.2
QF: KQUAD,L=0.2,K1=1.2,N_SLICES=4,INTEGRATION_ORDER=4,MALIGN_METHOD=4,DX=1e-4,DY=-5e-5,DZ=2e-4,PITCH=1e-4,YAW=-2e-4,TILT=0.01
QD: KQUAD,L=0.2,K1=-1.2,N_SLICES=4,INTEGRATION_ORDER=4,MALIGN_METHOD=3,DX=1e-4,DY=-5e-5,DZ=2e-4,PITCH=1e-4,YAW=-2e-4,TILT=0.01
SF: KSEXT,L=0.1,K2=20,N_SLICES=4,INTEGRATION_ORDER=4,MALIGN_METHOD=4,DX=1e-4,DY=-5e-5,DZ=2e-4,PITCH=1e-4,YAW=-2e-4,TILT=0.01
B: CSBEND,L=0.2,ANGLE=0.02,N_SLICES=4,INTEGRATION_ORDER=4,MALIGN_METHOD=4,DX=1e-4,EPITCH=1e-4,TILT=0.01
CELL: LINE=(D,QF,D,SF,D,QD,D,B)
RING: LINE=(MA,4*CELL)
