&run_setup lattice = "lattice.lte", use_beamline = "RING", p_central_mev = 1000, default_order = 1, rootname = "run", sigma = "%s.sig", centroid = "%s.cen", tracking_updates = 0, random_number_seed = 987654321 &end
&run_control n_passes = 1 &end
&bunched_beam n_particles_per_bunch = 20000, emit_x = 2e-8, beta_x = 8, emit_y = 2e-8, beta_y = 8, sigma_dp = 0, sigma_s = 0 &end
&track &end
