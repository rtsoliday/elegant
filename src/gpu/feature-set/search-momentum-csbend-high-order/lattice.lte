! FODO ring whose bends carry K3 to K8, sized so each term matters at search amplitudes
D: DRIF,L=0.20
QF: KQUAD,L=0.20,K1=1.20,N_SLICES=8,INTEGRATION_ORDER=4
QD: KQUAD,L=0.20,K1=-1.10,N_SLICES=8,INTEGRATION_ORDER=4
SF: KSEXT,L=0.10,K2=18,N_SLICES=8,INTEGRATION_ORDER=4
SD: KSEXT,L=0.10,K2=-16,N_SLICES=8,INTEGRATION_ORDER=4
B1: CSBEND,L=0.50,ANGLE=0.04,E1=0.02,E2=0.02,K1=0.08,K2=0.04,K3=14,K4=1900,K5=2e5,K6=2e7,K7=2e9,K8=2e11,&
  N_SLICES=8,INTEGRATION_ORDER=4,EDGE_ORDER=1
B2: CSBEND,L=0.50,ANGLE=-0.04,E1=-0.02,E2=-0.02,K1=-0.08,K2=-0.04,K3=-10,K4=1500,K5=-3e5,K6=1e7,K7=-1e9,K8=3e11,&
  N_SLICES=6,INTEGRATION_ORDER=2,EDGE_ORDER=1
AP: RCOL,X_MAX=0.015,Y_MAX=0.010
CELL: LINE=(D,QF,D,B1,AP,D,SF,D,QD,D,B2,AP,D,SD)
RING: LINE=(12*CELL)
