! Ordinary tracking through CSBENDs with K3 to K8, with amplitudes where every term matters
&run_setup
  lattice = "lattice.lte",
  use_beamline = "L",
  p_central_mev = 6000,
  default_order = 2,
  output = "%s.out",
  final = "%s.fin",
  centroid = "%s.cen",
  semaphore_file = "%s.done",
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 2000,
  emit_x = 5e-6,
  emit_y = 2e-6,
  beta_x = 5,
  beta_y = 5,
  sigma_dp = 0.01,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track &end
