! CSBENDs with K3 to K8: two integration orders, both bend directions, and one tilted and offset
D: DRIF,L=0.20
B1: CSBEND,L=0.50,ANGLE=0.04,E1=0.02,E2=0.02,K1=0.08,K2=0.04,K3=14,K4=1900,K5=2e5,K6=2e7,K7=2e9,K8=2e11,&
  N_SLICES=8,INTEGRATION_ORDER=4,EDGE_ORDER=1
B2: CSBEND,L=0.50,ANGLE=-0.04,E1=-0.02,E2=-0.02,K1=-0.08,K2=-0.04,K3=-10,K4=1500,K5=-3e5,K6=1e7,K7=-1e9,K8=3e11,&
  N_SLICES=6,INTEGRATION_ORDER=2,EDGE_ORDER=1
B3: CSBEND,L=0.40,ANGLE=0.02,K3=-20,K5=4e5,K7=-3e9,N_SLICES=8,INTEGRATION_ORDER=4,TILT=0.01,DX=1e-4,DY=-2e-4,DZ=1e-4
L: LINE=(B1,D,B2,D,B3)
