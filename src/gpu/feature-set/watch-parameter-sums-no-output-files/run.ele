! Parameter and centroid WATCH sums with no centroid or sigma file. Parameter sums use the device by the default rule.
&run_setup
 lattice = "lattice.lte",
 use_beamline = "RING",
 p_central_mev = 1000,
 default_order = 2,
 rootname = run,
 semaphore_file = "%s.done",
 random_number_seed = 987654321,
 tracking_updates = 0,
 show_element_timing = 1,
 load_balancing_on = 0,
&end

&run_control
 n_passes = 3,
&end

&bunched_beam
 n_particles_per_bunch = 2000,
 bunch = "%s.bun",
 emit_x = 1e-9,
 beta_x = 10,
 alpha_x = 0,
 emit_y = 1e-9,
 beta_y = 10,
 alpha_y = 0,
 sigma_dp = 3e-3,
 sigma_s = 1e-2,
 dp_s_coupling = 0.8,
 distribution_type[0] = 3*"gaussian",
 distribution_cutoff[0] = 3*3,
&end

&track
&end
