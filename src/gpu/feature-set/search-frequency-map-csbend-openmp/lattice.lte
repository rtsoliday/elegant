D: DRIF,L=0.4
QF: KQUAD,L=0.2,K1=1.5,N_SLICES=4,INTEGRATION_ORDER=4
QD: KQUAD,L=0.2,K1=-1.5,N_SLICES=4,INTEGRATION_ORDER=4
B1: CSBEND,L=0.3,ANGLE=0.01,E1=0.005,E2=0.005,N_SLICES=4,INTEGRATION_ORDER=4,EDGE_ORDER=1,EDGE1_EFFECTS=5,EDGE2_EFFECTS=5,MALIGN_METHOD=4,DX=1e-4
B2: CSBEND,L=0.3,ANGLE=-0.01,N_SLICES=4,INTEGRATION_ORDER=4,EDGE1_EFFECTS=0,EDGE2_EFFECTS=0,MALIGN_METHOD=2,DY=1e-4
