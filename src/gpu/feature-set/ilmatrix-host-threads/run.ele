! ILMATRIX with a beam large enough for the host thread pool to take the sines and cosines
! (ELEGANT_GPU_ISR_REFERENCE_THREADS=4 from suite.json). Any number of threads must give the same.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 3 &end
&bunched_beam
  n_particles_per_bunch = 60000,
  emit_x = 5e-11, beta_x = 7, alpha_x = 0.3,
  emit_y = 5e-12, beta_y = 2.5, alpha_y = -0.2,
  sigma_dp = 1e-3, sigma_s = 4e-3,
&end
&track &end
