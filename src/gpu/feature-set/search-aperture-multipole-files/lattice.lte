D: DRIF,L=0.20
QF: KQUAD,L=0.20,K1=1.2,N_SLICES=8,INTEGRATION_ORDER=4,SYSTEMATIC_MULTIPOLES="../data/mult_quad_systematic.sdds",RANDOM_MULTIPOLES="../data/mult_quad_random.sdds"
