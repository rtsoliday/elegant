! search-frequency-map-program with full_grid_output=1 and three momentum offsets: a row for every
! point, lost or not.
&run_setup
    lattice = "lattice.lte",
    use_beamline = "RING",
    p_central_mev = 6000,
    default_order = 2,
    semaphore_file = "%s.done"
&end

&run_control
    n_steps = 1,
    n_passes = 64
&end

&frequency_map
    output = "%s.fma",
    nx = 15,
    ny = 15,
    xmin = 1e-6,
    xmax = 0.005,
    ymin = 1e-6,
    ymax = 0.005,
    ndelta = 3,
    delta_min = -1e-3,
    delta_max = 1e-3,
    full_grid_output = 1,
    include_changes = 1,
    verbosity = 0
&end
