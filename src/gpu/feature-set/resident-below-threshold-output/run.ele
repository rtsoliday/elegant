! resident-below-threshold with an output file, which used to send the beam back for each collimator's length below 10,000 particles. Device exact drifts match the CPU, so they keep the resident rule.

&run_setup
 lattice = "lattice.lte",
 use_beamline = "RING",
 p_central_mev = 1000,
 default_order = 2,
 rootname = run,
 output = "%s.out",
 centroid = "%s.cen",
 sigma = "%s.sig",
 semaphore_file = "%s.done",
 random_number_seed = 987654321,
 tracking_updates = 0,
 load_balancing_on = 0,
&end

&run_control
 n_passes = 2,
&end

&bunched_beam
 n_particles_per_bunch = 12000,
 bunch = "%s.bun",
 emit_x = 1e-6,
 beta_x = 10,
 alpha_x = 0,
 emit_y = 1e-6,
 beta_y = 10,
 alpha_y = 0,
 sigma_dp = 1e-3,
 sigma_s = 1e-3,
 distribution_type[0] = 3*"gaussian",
 distribution_cutoff[0] = 3*3,
&end

&track
&end
