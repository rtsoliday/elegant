! Batched frequency map on a FODO ring whose focusing quadrupoles are a CSBEND and a CCBEND, with a SCRAPER tighter than the MAXAMP on -x. Beta peaks inside the bends, so some particles leave the aperture only inside them. Under GPU_VERIFY the fused prepass decides which particles survive.

&run_setup
    lattice = "lattice.lte",
    use_beamline = "RING",
    p_central_mev = 6000,
    default_order = 2,
    semaphore_file = "%s.done"
&end

&run_control
    n_steps = 1,
    n_passes = 32
&end

&frequency_map
    output = "%s.fma",
    ndelta = 1,
    delta_min = 0,
    delta_max = 0,
    nx = 16,
    ny = 8,
    xmin = -9.5e-3,
    xmax = 9.5e-3,
    ymin = 1e-6,
    ymax = 9.5e-3,
    full_grid_output = 1,
    include_changes = 1,
    verbosity = 0
&end
