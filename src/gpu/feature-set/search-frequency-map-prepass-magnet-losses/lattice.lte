D: DRIF,L=1.5
QD: KQUAD,L=0.5,K1=-0.8,N_SLICES=4,INTEGRATION_ORDER=4
BC: CSBEND,L=0.5,ANGLE=0.01,K1=0.8,N_SLICES=8,INTEGRATION_ORDER=4,EDGE_ORDER=1
BR: CCBEND,L=0.5,ANGLE=0.01,K1=0.8,N_SLICES=8,INTEGRATION_ORDER=4,OPTIMIZE_FSE=1,OPTIMIZE_DX=1
MA: MAXAMP,X_MAX=10e-3,Y_MAX=10e-3
SC: SCRAPER,L=0,POSITION=-6e-3,INSERT_FROM="-x"
CELLC: LINE=(BC,D,QD,D)
CELLR: LINE=(BR,D,QD,D)
RING: LINE=(MA,2*CELLC,SC,2*CELLR)
