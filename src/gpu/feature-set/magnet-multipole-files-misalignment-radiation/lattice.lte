D: DRIF,L=0.2
QF: KQUAD,L=0.2,K1=1.2,FSE=1e-3,DX=1e-4,DY=-5e-5,DZ=1e-4,TILT=0.01,N_SLICES=4,INTEGRATION_ORDER=4,SYNCH_RAD=1,SYSTEMATIC_MULTIPOLES="../data/mult_quad_systematic.sdds",RANDOM_MULTIPOLES="../data/mult_quad_random.sdds"
QD: KQUAD,L=0.2,K1=-1.2,TILT=-0.02,N_SLICES=4,INTEGRATION_ORDER=4,EDGE1_EFFECTS=1,EDGE2_EFFECTS=1,EDGE_MULTIPOLES="../data/mult_edge.sdds",SYSTEMATIC_MULTIPOLES="../data/mult_quad_systematic.sdds"
QB: KQUAD,L=0.2,BORE=0.02,B=0.05,N_SLICES=4,INTEGRATION_ORDER=4,SYSTEMATIC_MULTIPOLES="../data/mult_quad_systematic.sdds"
QL: KQUAD,L=0.3,LEFFECTIVE=0.2,K1=0.8,N_SLICES=4,INTEGRATION_ORDER=4,SYSTEMATIC_MULTIPOLES="../data/mult_quad_systematic.sdds"
SF: KSEXT,L=0.1,K2=20,DX=-1e-4,TILT=0.02,N_SLICES=4,INTEGRATION_ORDER=4,SYNCH_RAD=1,SYSTEMATIC_MULTIPOLES="../data/mult_sext_systematic.sdds"
O: KOCT,L=0.1,K3=300,DY=1e-4,TILT=0.01,N_SLICES=4,INTEGRATION_ORDER=4,SYSTEMATIC_MULTIPOLES="../data/mult_oct_systematic.sdds"
CELL: LINE=(D,QF,D,SF,D,QD,D,QB,D,QL,D,O)
RING: LINE=(3*CELL)
