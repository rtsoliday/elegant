CHG: CHARGE,TOTAL=1.0e-9
D1: DRIF,L=0.20

WA2: CWAKE,INPUTFILE="../data/wake_cwake.sdds",TCOLUMN="t",WZCOLUMN="Wz",WXCOLUMN="Wx",WYCOLUMN="Wy",QXCOLUMN="Qx",QYCOLUMN="Qy",CXCOLUMN="Cx",CYCOLUMN="Cy",N_BINS=256,INTERPOLATE=1,SMOOTHING=0,BUNCHED_BEAM_MODE=1,START_BUNCH=50,END_BUNCH=60,CHANGE_P0=1


MAKE: LINE=(D1)
CELL: LINE=(D1,WA2,D1)
RING: LINE=(CHG,4*CELL)
