! 1,500 particles for 40 passes with concat_order=1. The estimate has to walk the concatenated
! elements: six for the device, which don't pay for the two copies around the PFILTER, so the beam
! stays on the CPU and the output is the CPU's bit for bit. Walking the lattice's 123 elements
! instead would send the beam to the device.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 1000,
  default_order = 1,
  concat_order = 1,
  rootname = "run",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 40 &end
&bunched_beam
  n_particles_per_bunch = 1500,
  emit_x = 1e-8, emit_y = 1e-8,
  beta_x = 5, beta_y = 5,
  sigma_dp = 1e-4, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end
&track &end
