! CSRCSBEND with a radius of 0.1 m and a beam that reaches past it, so particles are lost inside the body
! after they entered on the device.  With no losses file they stay lost on the device, in the CPU's order.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = run,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 2000,
  emit_x = 1e-2,
  beta_x = 7,
  alpha_x = 0,
  emit_y = 1e-9,
  beta_y = 7,
  alpha_y = 0,
  sigma_dp = 1e-4,
  sigma_s = 3e-4,
&end

&track &end
