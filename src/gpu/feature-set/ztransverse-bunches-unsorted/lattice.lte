CHG: CHARGE,TOTAL=1.0e-9
D1: DRIF,L=0.20
CUT: RCOL,X_MAX=3.0e-4,Y_MAX=1.2e-4
Z1: ZTRANSVERSE, INPUTFILE="../data/impedance.sdds", FREQCOLUMN="f", &
  ZXREAL="ReZxD", ZXIMAG="ImZxD", ZYREAL="ReZyD", ZYIMAG="ImZyD", &
  INTERPOLATE=1, FACTOR=1e-2, BUNCHED_BEAM_MODE=1, WAKES="%s.twk"
ZQ: ZTRANSVERSE, INPUTFILE="../data/impedance.sdds", FREQCOLUMN="f", &
  ZXREAL="ReZxQ", ZXIMAG="ImZxQ", ZYREAL="ReZyQ", ZYIMAG="ImZyQ", &
  X_DRIVE_EXPONENT=0, Y_DRIVE_EXPONENT=0, X_PROBE_EXPONENT=1, Y_PROBE_EXPONENT=1, &
  INTERPOLATE=0, FACTOR=1e-3, BUNCHED_BEAM_MODE=1, END_BUNCH=1
MAKE: LINE=(D1)
CELL: LINE=(D1,Z1,D1,ZQ)
RING: LINE=(CHG,CUT,4*CELL)
