! 1,500 particles. Each lone kick quadrupole pays for its trip to the device (0.62 ms on the CPU against
! 0.18 ms), so tracking takes them, the estimate counts them, and the thresholds come down: the beam is
! on the device at W. With ELEGANT_GPU_SHORT_GPU_ISLAND_BY_COST=0 the output is the CPU's bit for bit.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "BL",
  p_central_mev = 1000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 1 &end
&bunched_beam
  n_particles_per_bunch = 1500,
  emit_x = 1e-8, emit_y = 1e-8,
  beta_x = 5, beta_y = 5,
  sigma_dp = 1e-4, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end
&track &end
