! Matrix magnets, monitors and combined correctors, which the batched momentum search takes
D: DRIF,L=0.20
QF: QUAD,L=0.20,K1=1.20
QD: QUAD,L=0.20,K1=-1.10
SF: SEXT,L=0.10,K2=18
SD: SEXT,L=0.10,K2=-16
B1: SBEN,L=0.50,ANGLE=0.04,E1=0.02,E2=0.02,K1=0.08,K2=0.04
B2: RBEN,L=0.50,ANGLE=-0.04,K1=-0.08,K2=-0.04
BPM: MONI,L=0.05
HB: HMON
VB: VMON,L=0.02
HC: KICKER,L=0.05,HKICK=1e-5,VKICK=-1e-5
EC: EKICKER,L=0.05,HKICK=-1e-5,VKICK=1e-5
AP: RCOL,X_MAX=0.004,Y_MAX=0.010
CELL: LINE=(D,QF,BPM,B1,AP,HB,SF,D,QD,VB,B2,AP,HC,SD,EC)
RING: LINE=(12*CELL)
