PF: PFILTER, LOWERFRACTION=0.03, UPPERFRACTION=0.03, FIXPLIMITS=1, DELTALIMIT=1.2e-3, BEAMCENTERED=1
BL: LINE=(Q1, D, R, D, PF, D)
