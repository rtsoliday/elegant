hmon: hmoni,l=0
vmon: vmoni,l=0
hc: mark
vc: mark
l1: drif,l=1.731675
l1a: drif,l=0.2
l1b: drif,l=1.531675
s1h: drif,l=0.1
s1: line=(s1h,hc,vc,s1h)
l2: drif,l=0.08
lqb: drif,l=0.24
q1q: kquad,l=0.23,k1=1.786022448154,n_kicks=40
q1: line=(hmon,vmon,q1q)
b0: sbend,l=0.8,angle=-0.785398163397,e1=-0.445,e2=-0.445,&
    hgap=0.0225,fint=0.41
b: line=(b0)
q2q: kquad,l=0.23,k1=2.295915530046,n_kicks=40
q2: line=(q2q,hmon,vmon)
l3: drif,l=1.47
sc1h: sext,l=0.1,k2=5.95873739969822
sc1: line=(sc1h,vc,sc1h)
l4: drif,l=0.08
q3q: kquad,l=0.23,n_kicks=40
q3: line=(vmon,q3q)
q4q: kquad,l=0.23,k1=2.270174600496,n_kicks=40
q4: line=(q4q,hmon)
l5: drif,l=0.325
sc2h: sext,l=0.1,k2=-1.65546424863732
ik2: drift,l=0.35
ik1: drift,l=0.35
ekm: drift,l=0.35
quadrant: line=(l1a,l1b,s1,l2,q1,lqb,b,lqb,q2,l3,sc1,l4,q3,lqb,b&
,lqb,q4,l5,sc2h)
ap: rcol,x_max=1,y_max=1
full: line=(2*(quadrant,hc,-quadrant),ap)
HC1: HKICK,L=0,KICK=0
HC2: HKICK,L=0,KICK=0
FULL2: LINE=(HC1,FULL,HC2)
VC1: VKICK,L=0,KICK=0
VC2: VKICK,L=0,KICK=0
RF1: RFCA,L=0.2,VOLT=1e5,PHASE=20,FREQ=5e8,T_REFERENCE=0,N_KICKS=0
M0: MONI,L=0
FOFB_RING: LINE=(HC1,VC1,RF1,FULL,M0,HC2,VC2)
return
