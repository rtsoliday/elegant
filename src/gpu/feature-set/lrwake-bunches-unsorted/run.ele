&run_setup
  lattice = "lattice.lte",
  use_beamline = "MAKE",
  p_central = 11742,
  default_order = 2,
  rootname = run_seed,
  output = "%s.out",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 0,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 2000,
  emit_x = 1e-9, emit_y = 1e-10, beta_x = 5, beta_y = 5,
  centroid[0] = 1.2e-4, 0, -8e-5, 0,
  sigma_dp = 1e-3, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian", distribution_cutoff[0] = 3*3,
&end

&track
&end

&run_setup
  lattice = "lattice.lte",
  use_beamline = "BL",
  p_central = 11742,
  default_order = 2,
  rootname = run,
  output = "%s.out",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 6,
&end

&sdds_beam
  input = run_seed.out,
  use_bunched_mode = 1,
  n_duplicates = 3,
  duplicate_stagger[4] = 0.6,
  fiducialization_bunch = -1,
&end

&track
&end
