CHG: CHARGE,TOTAL=1.0e-9
D1: DRIF,L=0.20
CUT: RCOL,X_MAX=1.2e-4,Y_MAX=1.2e-4
Z1: ZLONGIT, ZREAL="../data/impedance.sdds=f+ReZL", ZIMAG="../data/impedance.sdds=f+ImZL", &
  INTERPOLATE=1, BUNCHED_BEAM_MODE=1, WAKES="%s.wz"
ZB: ZLONGIT, BROAD_BAND=1, RA=1e4, Q=1, FREQ=2e10, BIN_SIZE=1e-12, N_BINS=256, &
  INTERPOLATE=1, BUNCHED_BEAM_MODE=1, START_BUNCH=1
MAKE: LINE=(D1)
CELL: LINE=(D1,Z1,D1,ZB)
RING: LINE=(CHG,CUT,4*CELL)
