D: DRIF,L=0.4
QF: KQUAD,L=0.2,K1=1.5,N_SLICES=4,INTEGRATION_ORDER=4
QD: KQUAD,L=0.2,K1=-1.5,N_SLICES=4,INTEGRATION_ORDER=4
SF: KSEXT,L=0.1,K2=5,N_SLICES=4,INTEGRATION_ORDER=4
MA: MAXAMP,X_MAX=12e-3,Y_MAX=12e-3
BC: CSBEND,L=0.2,ANGLE=0.001,N_SLICES=4,INTEGRATION_ORDER=4,EDGE_ORDER=1
BR: CCBEND,L=0.2,ANGLE=0.001,N_SLICES=4,INTEGRATION_ORDER=4,OPTIMIZE_FSE=1,OPTIMIZE_DX=1
RC: RCOL,L=0.01,X_MAX=10e-3,Y_MAX=10e-3
EC: ECOL,L=0.01,X_MAX=9e-3,Y_MAX=9e-3
SC: SCRAPER,L=0,POSITION=8e-3,INSERT_FROM="+x"
TC: TAPERAPC,L=0.05,RSTART=7.5e-3,REND=7.5e-3
TR: TAPERAPR,L=0.05,XSTART=7e-3,XEND=7e-3,YSTART=7e-3,YEND=7e-3
SB: SPEEDBUMP,L=0.2,CHORD=0.1,DZCENTER=0,HEIGHT=1e-3,POSITION=6.5e-3,INSERT_FROM="-x"
BPM: MONI,L=0.3
HB: HMON,L=0.1
VB: VMON,L=0.1
CELL1: LINE=(D,QF,BPM,SF,HB,QD,VB)
CELL2: LINE=(RC,D,QF,D,EC,D,SF,D,SC,D,QD,D,TC,TR,SB)
RING: LINE=(MA,BC,BR,CELL2,7*CELL1)
