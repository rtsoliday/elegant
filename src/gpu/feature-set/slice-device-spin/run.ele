! SLICE with spin tracking: rows of more than seven columns on the device; the spin sums accumulate_beam_sums()
! makes aren't written by SLICE. Identical
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
  spin_tracking = 1,
&end
&run_control n_passes = 2 &end
&bunched_beam
  n_particles_per_bunch = 5000,
  emit_x = 5e-11, beta_x = 7, alpha_x = 0.3,
  emit_y = 5e-12, beta_y = 2.5, alpha_y = -0.2,
  sigma_dp = 0.001, sigma_s = 0.004,
  spin[0] = 0.6, 0, 0.8,
&end
&track &end
