! MALIGN, EMATRIX, MATR with a chirp, so each reference time matters, and ENERGY with a given momentum, in one pass through 20 cells, with output, final and a coordinate WATCH, by the default rule. These match the CPU exactly on the device.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 3,
  rootname = run,
  output = "%s.out",
  final = "%s.fin",
  semaphore_file = "%s.done",
  random_number_seed = 987654321,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = 2000,
  bunch = "%s.bun",
  emit_x = 2e-9,
  beta_x = 10,
  alpha_x = 0,
  emit_y = 2e-9,
  beta_y = 8,
  alpha_y = 0,
  sigma_dp = 1e-4,
  sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
