D1: DRIF,L=0.25
QF: QUAD,L=0.2,K1=1.1,ORDER=3
QD: QUAD,L=0.2,K1=-1.0,ORDER=3
MAL: MALIGN,DX=1e-5,DXP=2e-6,DY=-8e-6,DYP=1.5e-6,DZ=2e-4,DP=2e-5,DT=1e-13
MALE: MALIGN,DE=3e-6,DZ=-1e-4
EM1: EMATRIX,L=0.12,ORDER=1,C1=1e-6,C3=-1e-6,R11=1,R12=0.12,R22=1,R33=1,R34=0.12,R44=1,R55=1,R66=1,DELTAP=0.05
MAT1: MATR,L=0.15,ORDER=1,FILENAME="chirp.rmat"
ENS: ENERGY,CENTRAL_MOMENTUM=11742
W1: WATCH,FILENAME="%s.w1",MODE=COORDINATE
CELL: LINE=(MAL,D1,QF,EM1,D1,QD,MAT1,MALE,ENS)
RING: LINE=(20*CELL,W1)
