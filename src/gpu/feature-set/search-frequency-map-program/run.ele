! A 15 by 15 map, two intervals of 32 turns, with the default grid output (a row only for a point with
! both tunes). The program tracks both intervals and the file is the CPU's bit for bit.
&run_setup
    lattice = "lattice.lte",
    use_beamline = "RING",
    p_central_mev = 6000,
    default_order = 2,
    semaphore_file = "%s.done"
&end

&run_control
    n_steps = 1,
    n_passes = 64
&end

&frequency_map
    output = "%s.fma",
    nx = 15,
    ny = 15,
    xmin = 1e-6,
    xmax = 0.005,
    ymin = 1e-6,
    ymax = 0.005,
    include_changes = 1,
    verbosity = 0
&end
