! SREFFECTS with excitation in small batches of particles. The results must not depend on the batch size.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 7000,
  default_order = 2,
  rootname = "run",
  centroid = "%s.cen",
  sigma = "%s.sig",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&twiss_output
  filename = "%s.twi",
  matched = 0,
  output_at_each_step = 0,
  beta_x = 8, alpha_x = 0, eta_x = 0.10, etap_x = 0.01,
  beta_y = 6, alpha_y = 0, eta_y = 0.05, etap_y = -0.005,
&end
&run_control n_passes = 2 &end

&bunched_beam
  n_particles_per_bunch = 2000,
  emit_x = 2e-9, beta_x = 8, alpha_x = 0,
  emit_y = 1e-9, beta_y = 6, alpha_y = 0,
  sigma_dp = 5e-4, sigma_s = 1e-3,
&end

&track &end
