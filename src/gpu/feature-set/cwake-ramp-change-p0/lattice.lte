  WZCOLUMN="Wz", WXCOLUMN="Wx", WYCOLUMN="Wy", &
  QXCOLUMN="Qx", QYCOLUMN="Qy", CXCOLUMN="Cx", CYCOLUMN="Cy", &
  N_BINS=256, RAMP_PASSES=3, CHANGE_P0=1, INTERPOLATE=1, SMOOTHING=0, BUNCHED_BEAM_MODE=1
RING: LINE=(Q,W)
