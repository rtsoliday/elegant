! One pass of 1,000 particles through the kick ring, with no CUDA context yet (the suite runs this
! case without ELEGANT_GPU_VERBOSE, which starts one). The device would save an estimated 0.006 s,
! under the 0.3 s a context is worth, so the beam stays on the CPU and the output is the CPU's bit
! for bit.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 1000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&run_control n_passes = 1 &end
&bunched_beam
  n_particles_per_bunch = 1000,
  emit_x = 1e-8, emit_y = 1e-8,
  beta_x = 5, beta_y = 5,
  sigma_dp = 1e-4, sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end
&track &end
