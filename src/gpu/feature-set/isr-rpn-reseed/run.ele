! KQUAD ISR with an RPN expression reseeding the random number generators each pass, through the library's random_1, so the device must start again from the new seed.
&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 7000,
  default_order = 2,
  rootname = "run",
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  tracking_updates = 0,
  random_number_seed = 987654321,
&end
&rpn_expression expression = "12345 srnd" &end
&modulate_elements
  name = "H", item = KICK,
  expression = "4321 srnd grnd 1e-6 *",
  refresh_matrix = 1,
  verbose = 0,
&end
&run_control n_passes = 4 &end

&bunched_beam
  n_particles_per_bunch = 256,
  emit_x = 5e-9, beta_x = 4, alpha_x = 0,
  emit_y = 5e-9, beta_y = 4, alpha_y = 0,
  sigma_dp = 5e-4, sigma_s = 1e-3,
&end

&track &end
