&global_settings
  tracking_matrix_step_size[4] = 1,
&end

&run_setup
  lattice = "lattice.lte",
  p_central_mev = 7e3,
  use_beamline = "BLF",
  default_order = 3,
  rootname = <root>,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  semaphore_file = "%s.done",
  tracking_updates = 0,
  show_element_timing = 1,
  random_number_seed = <seed>,
&end

&alter_elements
  name = "Q1F",
  item = "PARTICLE_OUTPUT_FILE",
  string_value = "<root>.boffaxe.pout",
&end

&alter_elements
  name = "Q1F",
  item = "FIELD_OUTPUT_FILE",
  string_value = "<root>.boffaxe.field",
&end

&run_control
  n_passes = <n_passes>,
&end

&bunched_beam
  n_particles_per_bunch = <n_particles>,
  distribution_type[0] = 2*"line",
  emit_x = 6e-10,
  beta_x = 10,
  emit_y = 6e-10,
  beta_y = 10,
  bunch = "%s.bun",
&end

&track
&end
