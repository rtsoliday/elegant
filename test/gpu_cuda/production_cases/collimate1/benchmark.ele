&run_setup
  lattice = "/home/soliday/oag/apps/src/elegantTestSet/collimate1/lattice.lte",
  use_beamline = "bl",
  rootname = <root>,
  p_central = "{rpnl 7e3 mev /}",
  default_order = 1,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  losses = "%s.los",
  show_element_timing = 1,
  tracking_updates = 0,
  random_number_seed = <seed>,
  semaphore_file = "%s.done",
&end

&run_control
  n_passes = <n_passes>,
&end

&bunched_beam
  n_particles_per_bunch = <n_particles>,
  bunch = "%s.bun",
  emit_x = 1e-12,
  emit_y = 1e-12,
  beta_x = 1e7,
  beta_y = 1e7,
  distribution_type[0] = 3*"hard",
  distribution_cutoff[0] = 3*1,
&end

&track
&end
