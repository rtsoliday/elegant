&run_setup
  lattice = "lattice.lte",
  use_beamline = "BL",
  p_central_mev = 3000,
  default_order = 1,
  rootname = <root>,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  semaphore_file = "%s.done",
  tracking_updates = 0,
  show_element_timing = 1,
  random_number_seed = <seed>,
&end

&run_control
  n_passes = <n_passes>,
&end

&ion_effects
  pressure_profile = "pressure.sdds",
  ion_properties = "ion_properties.sdds",
  field_calculation_method = "poisson",
  macro_ions = 64,
  generation_interval = 1,
  ion_span[0] = 1e-2,
  ion_span[1] = 1e-2,
  ion_poisson_bins[0] = 16,
  ion_poisson_bins[1] = 16,
  ion_poisson_span[0] = 1e-2,
  ion_poisson_span[1] = 1e-2,
  ion_bin_divisor[0] = 10,
  ion_bin_divisor[1] = 10,
  ion_output_interval = 1,
  verbosity = 0,
&end

&bunched_beam
  n_particles_per_bunch = <n_particles>,
  bunch = "%s.bun",
  emit_x = 2e-8,
  beta_x = 5,
  alpha_x = 0,
  emit_y = 2e-8,
  beta_y = 5,
  alpha_y = 0,
  sigma_dp = 1e-5,
  sigma_s = 2e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
