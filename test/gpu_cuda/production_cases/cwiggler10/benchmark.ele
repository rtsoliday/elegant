&run_setup
  lattice = "lattice.lte",
  p_central_mev = 800,
  use_beamline = "BLT",
  rootname = <root>,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  semaphore_file = "%s.done",
  tracking_updates = 0,
  show_element_timing = 1,
  random_number_seed = <seed>,
&end

&alter_elements
  name = "OK4WIGH",
  item = "STEPS_PER_PERIOD",
  value = 20,
&end

&alter_elements
  name = "OK4WIGH",
  item = "FIELD_OUTPUT",
  string_value = "<root>.cwigOut",
&end

&run_control
  n_passes = <n_passes>,
&end

&bunched_beam
  n_particles_per_bunch = <n_particles>,
  emit_x = 1e-6,
  emit_y = 1e-6,
  beta_x = 1e2,
  beta_y = 1e2,
  bunch = "%s.bun",
&end

&track
&end
