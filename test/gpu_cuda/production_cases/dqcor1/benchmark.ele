&run_setup
  lattice = "/home/soliday/oag/apps/src/elegantTestSet/DQCOR1/lattice.lte",
  use_beamline = "bldq",
  rootname = <root>,
  p_central_mev = 1e3,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  show_element_timing = 1,
  tracking_updates = 0,
  random_number_seed = <seed>,
  semaphore_file = "%s.done",
&end

&matrix_output
  SDDS_output = "%s.mat",
  SDDS_output_order = 2,
&end

&run_control
  n_passes = <n_passes>,
&end

&bunched_beam
  n_particles_per_bunch = <n_particles>,
  emit_x = 1e-8,
  emit_y = 1e-8,
  beta_x = 1,
  beta_y = 1,
  sigma_dp = 1e-3,
  distribution_cutoff[0] = 3*3,
  distribution_type[0] = 3*"gaussian",
&end

&track
&end
