&run_setup
  lattice = "/home/soliday/oag/apps/src/elegantTestSet/LCLS0/LCLS.lte",
  use_beamline = "beamline",
  rootname = <root>,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  parameters = "%s.par",
  magnets = "%s.mag",
  combine_bunch_statistics = 0,
  default_order = 1,
  concat_order = 0,
  print_statistics = 0,
  show_element_timing = 1,
  random_number_seed = <seed>,
  p_central = 294.12970,
  tracking_updates = 0,
  load_balancing_on = 0,
  search_path = "/home/soliday/oag/apps/src/elegantTestSet/LCLS0",
