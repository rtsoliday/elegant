&run_setup
  lattice = "/home/soliday/oag/apps/src/elegantTestSet/maxamp1/aps.lte",
  use_beamline = "RING",
  rootname = <root>,
  p_central = "{rpnl 7e3 mev /}",
  default_order = 1,
  concat_order = 1,
  losses = "%s.los",
  acceptance = "%s.acc",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  output = "%s.out",
  wrap_around = 0,
  show_element_timing = 1,
  tracking_updates = 0,
  random_number_seed = <seed>,
  semaphore_file = "%s.done",
&end

&run_control
  n_passes = <n_passes>,
&end

&error_control
  clear_error_settings = 1,
  error_log = "%s.erl",
&end

&error_element
  name = "S*:Q?",
  item = "TILT",
  amplitude = 1e-3,
&end

&error_element
  name = "S*:S?",
  item = "TILT",
  amplitude = 1e-3,
&end

&bunched_beam
  n_particles_per_bunch = <n_particles>,
  emit_x = 300e-9,
  emit_y = 30e-9,
  beta_x = 20,
  beta_y = 3,
  centroid[0] = -10e-3,
&end

&track
&end
