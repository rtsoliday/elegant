&run_setup
  lattice = "/home/soliday/oag/apps/src/elegantTestSet/csbend1/lattice.lte",
  use_beamline = "bl",
  rootname = <root>,
  p_central_mev = 7e3,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  show_element_timing = 1,
  tracking_updates = 0,
  random_number_seed = <seed>,
  semaphore_file = "%s.done",
&end

&run_control
  n_passes = <n_passes>,
&end

&bunched_beam
  bunch = "%s.bun",
  n_particles_per_bunch = <n_particles>,
&end

&track
&end
