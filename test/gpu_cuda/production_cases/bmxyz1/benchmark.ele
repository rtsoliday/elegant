&run_setup
  lattice = "lattice.lte",
  p_central_mev = 6e3,
  use_beamline = "LQ",
  default_order = 1,
  rootname = <root>,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  semaphore_file = "%s.done",
  tracking_updates = 0,
  show_element_timing = 1,
  random_number_seed = <seed>,
&end

&run_control
  n_passes = <n_passes>,
&end

&bunched_beam
  n_particles_per_bunch = <n_particles>,
  distribution_type[0] = 2*"line",
  emit_x = 6e-33,
  beta_x = 6e27,
  emit_y = 6e-33,
  beta_y = 6e27,
  bunch = "%s.bun",
  distribution_cutoff[0] = 100, 100,
&end

&track
&end
