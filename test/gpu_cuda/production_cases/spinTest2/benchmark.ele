&run_setup
  lattice = "/home/soliday/oag/apps/src/elegantTestSet/spinTest2/par.lte",
  use_beamline = "par",
  rootname = <root>,
  p_central_mev = 450,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  magnets = "%s.mag",
  spin_tracking = 1,
  show_element_timing = 1,
  tracking_updates = 0,
  random_number_seed = <seed>,
  semaphore_file = "%s.done",
&end

&twiss_output
  filename = "%s.twi",
  matched = 1,
  radiation_integrals = 1,
&end

&run_control
  n_passes = <n_passes>,
&end

&bunched_beam
  n_particles_per_bunch = <n_particles>,
  use_twiss_command_values = 1,
  emit_x = 3.3356e-7,
  emit_y = 3.3356e-8,
  sigma_dp = 0.0408e-2,
  spin[0] = 1, 0, 0,
  centroid[0] = 1e-3, 0, 1e-3,
&end

&track
&end
