CHG: CHARGE,TOTAL=1.0e-9
D1: DRIF,L=0.20

WASKIP: WAKE,INPUTFILE="../wake_trwake/wake_long.sdds",TCOLUMN="t",WCOLUMN="W",N_BINS=512,INTERPOLATE=1,SMOOTHING=0,ALLOW_LONG_BEAM=1,BUNCHED_BEAM_MODE=1,START_BUNCH=3,END_BUNCH=-1,CHANGE_P0=1

MAKE: LINE=(D1)
CELL: LINE=(D1,WASKIP,D1)
RING: LINE=(CHG,6*CELL)
