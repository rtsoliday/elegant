CHG: CHARGE,TOTAL=1.0e-9
D1: DRIF,L=0.20

WA12: WAKE,INPUTFILE="../wake_trwake/wake_long.sdds",TCOLUMN="t",WCOLUMN="W",N_BINS=512,INTERPOLATE=1,SMOOTHING=0,ALLOW_LONG_BEAM=1,BUNCHED_BEAM_MODE=1,START_BUNCH=0,END_BUNCH=1,CHANGE_P0=1
WAALL: WAKE,INPUTFILE="../wake_trwake/wake_long.sdds",TCOLUMN="t",WCOLUMN="W",N_BINS=0,INTERPOLATE=1,SMOOTHING=0,ALLOW_LONG_BEAM=1,BUNCHED_BEAM_MODE=1,START_BUNCH=0,END_BUNCH=-1
TW23: TRWAKE,INPUTFILE="../wake_trwake/wake_tr.sdds",TCOLUMN="t",WXCOLUMN="Wx",WYCOLUMN="Wy",N_BINS=256,INTERPOLATE=1,SMOOTHING=0,BUNCHED_BEAM_MODE=1,START_BUNCH=1,END_BUNCH=2

MAKE: LINE=(D1)
CELL: LINE=(D1,WA12,D1,TW23,D1,WAALL,D1)
RING: LINE=(CHG,3*CELL)
