&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = <root>,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  acceptance = "%s.acc",
  semaphore_file = "%s.done",
  random_number_seed = <seed>,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = <n_passes>,
&end

&bunched_beam
  n_particles_per_bunch = <n_particles>,
  bunch = "%s.bun",
  emit_x = 4e-8,
  beta_x = 14,
  alpha_x = 0,
  emit_y = 3e-11,
  beta_y = 11,
  alpha_y = 0,
  sigma_dp = 4e-5,
  sigma_s = 3e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
