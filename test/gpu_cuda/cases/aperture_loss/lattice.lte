D1: DRIF,L=0.20
KQF: KQUAD,L=0.25,K1=1.10,N_SLICES=4,INTEGRATION_ORDER=4,SYNCH_RAD=0,ISR=0
KQD: KQUAD,L=0.25,K1=-1.00,N_SLICES=4,INTEGRATION_ORDER=4,SYNCH_RAD=0,ISR=0
RC: RCOL,L=0.01,X_MAX=6.0e-4,Y_MAX=5.0e-4
EC: ECOL,L=0.01,X_MAX=7.0e-4,Y_MAX=5.5e-4
MA: MAXAMP,X_MAX=8.0e-4,Y_MAX=6.0e-4,ELLIPTICAL=1
CELL: LINE=(MA,D1,KQF,D1,RC,D1,KQD,D1,EC)
RING: LINE=(4*CELL)
