&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 3,
  rootname = <root>,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  semaphore_file = "%s.done",
  random_number_seed = <seed>,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = <n_passes>,
&end

&modulate_elements
  name = "QF",
  item = "K1",
  expression = "1e6 * 0.05 +",
  differential = 0,
  multiplicative = 0,
  refresh_matrix = 1,
&end

&bunched_beam
  n_particles_per_bunch = <n_particles>,
  bunch = "%s.bun",
  emit_x = 2e-9,
  beta_x = 10,
  alpha_x = 0,
  emit_y = 2e-9,
  beta_y = 8,
  alpha_y = 0,
  sigma_dp = 1e-4,
  sigma_s = 1e-3,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end
