D1: DRIF,L=0.25
QF: QUAD,L=0.2,K1=0.05,ORDER=3
QD: QUAD,L=0.2,K1=-0.05,ORDER=3
MAL: MALIGN,DX=1e-6,DXP=2e-7,DY=-8e-7,DYP=1.5e-7,DZ=2e-5,DP=2e-6,DT=1e-14
CEN6: CENTER,X=0,XP=0,Y=0,YP=0,S=0,DELTA=0,T=1,ONCE_ONLY=0
CENALL: CENTER,X=1,XP=1,Y=1,YP=1,S=0,DELTA=0,T=1,ONCE_ONLY=0
BPM: MONI,L=0
CELL: LINE=(MAL,CEN6,D1,QF,CENALL,D1,QD,BPM)
RING: LINE=(4*CELL)
