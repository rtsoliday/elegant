&run_setup
  lattice = "lattice.lte",
  use_beamline = "MAKE",
  p_central_mev = 6000,
  default_order = 2,
  rootname = <root>_seed,
  output = "%s.out",
  final = "%s.fin",
  semaphore_file = "%s.done",
  random_number_seed = <seed>,
  tracking_updates = 0,
  show_element_timing = 0,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = <n_particles>,
  bunch = "%s.bun",
  emit_x = 1e-9,
  beta_x = 8,
  alpha_x = 0,
  emit_y = 1e-9,
  beta_y = 8,
  alpha_y = 0,
  sigma_dp = 5e-5,
  sigma_s = 3e-4,
  centroid[0] = 2.0e-4,
  centroid[2] = -1.2e-4,
  centroid[4] = 1.5e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end

&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = <root>,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  semaphore_file = "%s.done",
  random_number_seed = <seed>,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = <n_passes>,
&end

&sdds_beam
  input = <root>_seed.out,
  use_bunched_mode = 1,
  n_duplicates = 2,
  duplicate_stagger[4] = 8.0e-10,
  fiducialization_bunch = 1,
&end

&track
&end
