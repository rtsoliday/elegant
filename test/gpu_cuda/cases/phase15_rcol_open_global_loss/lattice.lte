RCXP: RCOL,L=0.05,X_MAX=8.0e-4,Y_MAX=6.0e-4,OPEN_SIDE="+x"
RCXM: RCOL,L=0.05,X_MAX=8.0e-4,Y_MAX=6.0e-4,OPEN_SIDE="-x"
RCYP: RCOL,L=0.05,X_MAX=8.0e-4,Y_MAX=6.0e-4,OPEN_SIDE="+y"
RCYM: RCOL,L=0.05,X_MAX=8.0e-4,Y_MAX=6.0e-4,OPEN_SIDE="-y"
D1: DRIF,L=0.20
QF: QUAD,L=0.25,K1=1.20,ORDER=3
QD: QUAD,L=0.25,K1=-1.10,ORDER=3
BPM: MONI,L=0
CELL: LINE=(D1,QF,D1,RCXP,D1,RCXM,D1,QD,D1,RCYP,D1,RCYM,D1,BPM)
RING: LINE=(6*CELL)
