&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 6000,
  default_order = 2,
  rootname = <root>,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  losses = "%s.los",
  semaphore_file = "%s.done",
  random_number_seed = <seed>,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&run_control
  n_passes = <n_passes>,
&end

&sdds_beam
  input = "invalid_beam.sdds",
  input_type = "elegant",
  reuse_bunch = 1,
&end

&track
&end
