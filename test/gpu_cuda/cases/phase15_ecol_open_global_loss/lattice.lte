EC0: ECOL,L=0,X_MAX=8.0e-4,Y_MAX=5.0e-4,EXPONENT=4,YEXPONENT=2,OPEN_SIDE="+X"
EC1: ECOL,L=0.05,X_MAX=9.0e-4,Y_MAX=5.5e-4,EXPONENT=4,YEXPONENT=2,OPEN_SIDE="-Y"
D1: DRIF,L=0.20
QF: QUAD,L=0.25,K1=1.20,ORDER=3
QD: QUAD,L=0.25,K1=-1.10,ORDER=3
SX: SEXT,L=0.10,K2=18.0,ORDER=3
BPM: MONI,L=0
CELL: LINE=(D1,QF,D1,EC0,D1,SX,D1,EC1,D1,QD,D1,BPM)
RING: LINE=(6*CELL)
