D1: DRIF,L=0.2
QF: QUAD,L=0.15,K1=0.35,ORDER=3
QD: QUAD,L=0.15,K1=-0.32,ORDER=3
SOL: SOLE,L=0.12,KS=0.35,DX=1e-6,DY=-2e-6,DZ=1e-5,ORDER=3
ROT: ROTATE,TILT=0.015,ON_PASS=-1,EXCLUDE_OPTICS=0
ROTX: ROTATE,TILT=-0.007,ON_PASS=-1,EXCLUDE_OPTICS=1
HC: HKICK,L=0.08,KICK=2e-5,TILT=0.01,B2=0.5,CALIBRATION=1,EDGE_EFFECTS=1,ORDER=3,SYNCH_RAD=0,ISR=0
VC: VKICK,L=0.08,KICK=-1.5e-5,TILT=-0.02,B2=0.4,CALIBRATION=1,EDGE_EFFECTS=1,ORDER=3,SYNCH_RAD=0,ISR=0
BPM: MONI,L=0
CELL: LINE=(D1,QF,SOL,ROT,HC,D1,VC,ROTX,QD,BPM)
RING: LINE=(6*CELL)
