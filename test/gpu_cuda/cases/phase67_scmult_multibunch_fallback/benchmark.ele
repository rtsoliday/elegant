&run_setup
  lattice = "make_beam.lte",
  use_beamline = "MAKE",
  p_central_mev = 1000,
  default_order = 2,
  rootname = <root>_seed,
  output = "%s.out",
  final = "%s.fin",
  semaphore_file = "%s.done",
  random_number_seed = <seed>,
  tracking_updates = 0,
  show_element_timing = 0,
  load_balancing_on = 0,
&end

&run_control
  n_passes = 1,
&end

&bunched_beam
  n_particles_per_bunch = <n_particles>,
  bunch = "%s.bun",
  emit_x = 2e-8,
  beta_x = 5,
  alpha_x = 0,
  emit_y = 2e-8,
  beta_y = 5,
  alpha_y = 0,
  sigma_dp = 2e-4,
  sigma_s = 4e-4,
  distribution_type[0] = 3*"gaussian",
  distribution_cutoff[0] = 3*3,
&end

&track
&end

&insert_sceffects
  name = "D*",
  type = "DRIF",
  element_prefix = "SCMB",
  horizontal = 1,
  vertical = 1,
  nonlinear = 0,
  skip = 1,
&end

&run_setup
  lattice = "lattice.lte",
  use_beamline = "RING",
  p_central_mev = 1000,
  default_order = 2,
  rootname = <root>,
  output = "%s.out",
  centroid = "%s.cen",
  sigma = "%s.sig",
  final = "%s.fin",
  semaphore_file = "%s.done",
  random_number_seed = <seed>,
  tracking_updates = 0,
  show_element_timing = 1,
  load_balancing_on = 0,
&end

&twiss_output
  matched = 0,
  filename = "%s.twi",
  output_at_each_step = 1,
  beta_x = 5,
  beta_y = 5,
&end

&run_control
  n_passes = <n_passes>,
&end

&sdds_beam
  input = <root>_seed.out,
  use_bunched_mode = 1,
  n_duplicates = 2,
  duplicate_stagger[4] = 1e-9,
  fiducialization_bunch = -1,
&end

&track
&end
