CHG: CHARGE,TOTAL=1.0e-9
D1: DRIF,L=0.10
BC: CSRCSBEND,L=0.40,ANGLE=0.04,N_SLICES=4,INTEGRATION_ORDER=4,BINS=2048,SG_HALFWIDTH=1,SG_ORDER=1,CSR=1,SYNCH_RAD=0,ISR=0,OUTPUT_FILE="%s.csr",OUTPUT_LAST_WAKE_ONLY=1
BD: CSRCSBEND,L=0.40,ANGLE=-0.04,N_SLICES=4,INTEGRATION_ORDER=4,BINS=2048,SG_HALFWIDTH=1,SG_ORDER=1,CSR=1,SYNCH_RAD=0,ISR=0
CD: CSRDRIFT,L=0.20,DZ=0.05,CSR=1,USE_SALDIN54=1,SALDIN54POINTS=200,SALDIN54NORM_MODE=peak,BUNCHLENGTH_MODE=68-percentile,SALDIN54_OUTPUT="%s.wake"
CELL: LINE=(D1,BC,CD,D1,BD,CD)
RING: LINE=(CHG,2*CELL)
